.tab-dock { position:fixed; z-index:100; right:20rpx; bottom:calc(12rpx + env(safe-area-inset-bottom)); left:20rpx; box-sizing:border-box; padding:8rpx; border:1rpx solid rgba(255,255,255,.86); border-radius:36rpx; background:rgba(245,249,253,.94); box-shadow:0 14rpx 38rpx rgba(20,43,69,.17); backdrop-filter:blur(18px) saturate(130%); -webkit-backdrop-filter:blur(18px) saturate(130%); }
.tab-dock-dark { border-color:rgba(255,255,255,.18); background:rgba(27,35,46,.94); box-shadow:0 14rpx 38rpx rgba(0,0,0,.28); }
.tab-dock-inner { display:flex; align-items:stretch; width:100%; }
.tab-item { display:flex; flex:1; flex-direction:column; align-items:center; justify-content:center; box-sizing:border-box; min-width:0; min-height:94rpx; border-radius:28rpx; color:#687786; }
.tab-dock-dark .tab-item { color:#c2ccd6; }
.tab-icon { display:block; width:36rpx; height:36rpx; }
.tab-label { display:block; margin-top:5rpx; font-size:20rpx; font-weight:650; line-height:1.2; text-align:center; }
