.page { box-sizing:border-box; min-height:100vh; padding:24rpx 32rpx 70rpx; background:linear-gradient(180deg,#edf6ff,#f5f7f9 430rpx); }.intro { padding:34rpx 36rpx; border-radius:30rpx; background:linear-gradient(135deg,#163e62,#0f6b73); color:#fff; }.kicker,.title,.subtitle { display:block; }.kicker { color:#7ee7dc; font-size:19rpx; font-weight:700; letter-spacing:3rpx; }.title { margin-top:12rpx; font-size:38rpx; font-weight:750; }.subtitle { margin-top:9rpx; font-size:22rpx; opacity:.8; }.card { margin-top:22rpx; padding:28rpx; border:1rpx solid rgba(24,73,107,.08); border-radius:26rpx; background:#fff; box-shadow:0 8rpx 24rpx rgba(31,65,86,.05); }.label { display:block; margin-bottom:10rpx; color:#66747d; font-size:23rpx; }.picker-value,input,textarea { box-sizing:border-box; width:100%; padding:18rpx 20rpx; border:1rpx solid #dce5e8; border-radius:15rpx; background:#f8fafb; color:#26343d; font-size:27rpx; }.picker-value,input { min-height:66rpx; } textarea { height:150rpx; }.field+.field { margin-top:28rpx; }.state,.message { color:#71808a; text-align:center; }.preview { display:block; width:100%; border-radius:18rpx; background:#eef2f3; }.preview.cover { height:240rpx; }.preview.plan { min-height:180rpx; }.image-actions { display:flex; gap:12rpx; margin-top:13rpx; }.image-actions button { flex:1; margin:0; border:0; border-radius:14rpx; background:#e7f2ff; color:#116bca; font-size:23rpx; }.image-actions button::after,.save::after { border:0; }.image-actions .remove { background:#fff0ee; color:#bd3e35; }.save { margin-top:38rpx; border:0; border-radius:999rpx; background:#147af3; color:#fff; font-size:27rpx; }.message { display:block; margin-top:16rpx; font-size:22rpx; }
.image-actions button { box-sizing:border-box; height:68rpx; padding:0 18rpx; }.save { box-sizing:border-box; height:88rpx; padding:0 28rpx; }
