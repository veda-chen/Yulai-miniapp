.admin-page { min-height:100vh; box-sizing:border-box; padding:24rpx 32rpx 60rpx; background:linear-gradient(180deg,#edf6ff,#f5f7f9 430rpx); }.admin-hero { padding:36rpx 38rpx; border-radius:32rpx; background:linear-gradient(135deg,#163e62,#0f6b73); color:#fff; box-shadow:0 14rpx 34rpx rgba(17,67,91,.18); }.hero-kicker,.hero-title,.hero-copy { display:block; }.hero-kicker { color:#7ee7dc; font-size:19rpx; font-weight:700; letter-spacing:3rpx; }.hero-title { margin-top:12rpx; font-size:40rpx; font-weight:750; }.hero-copy { margin-top:10rpx; font-size:23rpx; opacity:.8; }
.metrics { display:flex; gap:12rpx; margin:24rpx 0; }.metric { flex:1; display:flex; flex-direction:column; align-items:center; padding:22rpx 8rpx; border:1rpx solid rgba(24,73,107,.08); border-radius:22rpx; background:#fff; color:#71808a; font-size:20rpx; box-shadow:0 8rpx 22rpx rgba(31,65,86,.05); }.number { margin-bottom:4rpx; font-size:38rpx; font-weight:750; }.metric-warn .number { color:#ec7b2c; }.metric-blue .number { color:#147af3; }.metric-green .number { color:#11866f; }
.tabs { width:100%; margin-bottom:22rpx; }.tab-track { display:flex; gap:12rpx; }.tab { flex:none; padding:13rpx 24rpx; border:1rpx solid #dfe6ea; border-radius:999rpx; background:#fff; color:#66747d; font-size:23rpx; }.tab.active { border-color:#147af3; background:#147af3; color:#fff; box-shadow:0 6rpx 16rpx rgba(20,122,243,.2); }
.report-card,.audit-card,.empty { margin-bottom:18rpx; padding:28rpx; border:1rpx solid rgba(24,73,107,.08); border-radius:26rpx; background:#fff; box-shadow:0 8rpx 24rpx rgba(31,65,86,.05); }.empty { color:#738088; text-align:center; }.empty.error { color:#c43d3d; }.card-top { display:flex; align-items:center; justify-content:space-between; gap:16rpx; }.target-pill,.action-pill { display:inline-block; padding:6rpx 13rpx; border-radius:999rpx; background:#e7f2ff; color:#116bca; font-size:19rpx; font-weight:650; }.action-pill { background:#e4f7f1; color:#08745f; }.reason { margin-left:12rpx; font-size:27rpx; font-weight:700; }.status { flex:none; padding:6rpx 12rpx; border-radius:999rpx; font-size:19rpx; }.status-OPEN { background:#fff0e3; color:#b85b19; }.status-RESOLVED { background:#e4f7f1; color:#08745f; }.status-DISMISSED { background:#eef0f2; color:#657078; }
.record-title { display:block; margin-top:17rpx; font-size:27rpx; font-weight:650; }.record-copy { display:block; margin-top:11rpx; color:#5d6a72; font-size:23rpx; line-height:1.55; }.details { color:#26343d; font-size:25rpx; }.date { color:#929ca2; font-size:19rpx; }.report-card>.date { display:block; margin-top:14rpx; }.object-row { display:flex; align-items:center; justify-content:space-between; gap:12rpx; margin-top:18rpx; padding:16rpx 0; border-top:1rpx solid #edf1f3; border-bottom:1rpx solid #edf1f3; color:#7b878e; font-size:20rpx; }.object-row navigator { flex:none; color:#147af3; font-weight:600; }
.resolution { display:flex; flex-direction:column; gap:8rpx; margin-top:18rpx; padding:18rpx; border-radius:16rpx; background:#f3f7f5; color:#4d5e57; font-size:22rpx; }.resolution-label { color:#11866f; font-weight:650; }.buttons { display:flex; justify-content:flex-end; gap:10rpx; margin-top:20rpx; }.action { min-width:0; margin:0; padding:0 20rpx; border:1rpx solid #d9e0e4; border-radius:999rpx; background:#fff; color:#52616a; font-size:21rpx; }.action::after { border:0; }.action.primary { border-color:#147af3; background:#147af3; color:#fff; }.action.danger { margin-right:auto; border-color:#f1c8c8; color:#b63b3b; }
