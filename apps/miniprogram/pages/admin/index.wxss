.page { padding:32rpx; }
.metrics { display:flex; gap:12rpx; margin-bottom:24rpx; }
.metric { flex:1; display:flex; flex-direction:column; align-items:center; padding:20rpx 8rpx; border-radius:18rpx; background:#fff; font-size:22rpx; color:#66736e; }
.number { color:#234e43; font-size:38rpx; font-weight:700; }
.report, .empty { margin-bottom:18rpx; padding:26rpx; border-radius:18rpx; background:#fff; }
.title { display:block; font-weight:600; }
.copy { display:block; margin-top:10rpx; color:#66736e; font-size:24rpx; }
.buttons { display:flex; justify-content:flex-end; margin-top:18rpx; }
