.appearance-page { box-sizing:border-box; min-height:100vh; padding:30rpx 32rpx calc(210rpx + env(safe-area-inset-bottom)); background:linear-gradient(180deg,var(--primary-soft) 0,var(--page-bg) 360rpx); color:var(--text); }.intro { padding:12rpx 8rpx 24rpx; }.eyebrow,.title,.copy,.section-title,.section-copy,.label,.hint,.preset-name,.preset-copy,.preview-label { display:block; }.eyebrow { color:var(--primary); font-size:19rpx; font-weight:750; letter-spacing:3rpx; }.title { margin-top:10rpx; font-size:43rpx; font-weight:780; line-height:1.25; }.copy { margin-top:10rpx; color:var(--muted); font-size:23rpx; line-height:1.55; }.section { margin-top:22rpx; padding:28rpx; }.section-heading { display:flex; align-items:flex-start; margin-bottom:24rpx; }.section-mark { flex:none; width:9rpx; height:34rpx; margin:4rpx 14rpx 0 0; border-radius:999rpx; background:var(--primary); box-shadow:0 0 0 7rpx var(--primary-soft); }.section-title { font-size:31rpx; font-weight:750; }.section-copy { margin-top:7rpx; color:var(--muted); font-size:20rpx; line-height:1.45; }
.preset-grid { display:flex; gap:12rpx; }.preset { flex:1; display:block; box-sizing:border-box; min-width:0; height:auto; margin:0; padding:12rpx; border:2rpx solid transparent; border-radius:var(--control-radius); background:var(--page-bg); color:var(--text); text-align:left; }.preset::after { border:0; }.preset:active { border-color:var(--primary); }.preset-art { position:relative; overflow:hidden; height:78rpx; border-radius:14rpx; background:linear-gradient(135deg,#087bf7,#214f86); }.preset.green .preset-art { background:linear-gradient(135deg,#11866f,#17473c); }.preset.orange .preset-art { background:linear-gradient(135deg,#d65f27,#7c3c21); }.preset-ball { position:absolute; top:16rpx; right:19rpx; width:20rpx; height:20rpx; border:3rpx solid rgba(255,255,255,.85); border-radius:50%; }.preset-line { position:absolute; right:0; bottom:20rpx; left:0; height:2rpx; background:rgba(255,255,255,.38); }.preset-name { margin-top:11rpx; font-size:21rpx; font-weight:700; }.preset-copy { margin-top:4rpx; overflow:hidden; color:var(--muted); font-size:17rpx; line-height:1.35; }
.label { margin:25rpx 0 13rpx; color:var(--muted); font-size:22rpx; }.choice-row { display:flex; gap:14rpx; }.choice { flex:1; display:flex; align-items:center; justify-content:center; gap:10rpx; box-sizing:border-box; min-width:0; height:70rpx; margin:0; padding:0 12rpx; border:2rpx solid var(--border); border-radius:var(--control-radius); background:var(--surface); color:var(--text); font-size:23rpx; }.choice::after,.order-row button::after { border:0; }.choice.selected { border-color:var(--primary); background:var(--primary-soft); color:var(--primary); font-weight:650; }.three .choice { font-size:20rpx; }.swatch { width:18rpx; height:18rpx; border:3rpx solid rgba(255,255,255,.82); border-radius:50%; box-shadow:0 0 0 2rpx rgba(0,0,0,.08); }.swatch.blue { background:#007aff; }.swatch.green { background:#11866f; }.swatch.orange { background:#d65f27; }.sample-choice { height:90rpx; }.density-sample { display:flex; flex-direction:column; justify-content:center; gap:7rpx; width:38rpx; height:44rpx; padding:0 7rpx; border:2rpx solid currentColor; border-radius:9rpx; }.density-sample view { height:3rpx; border-radius:3rpx; background:currentColor; }.density-sample.compact { height:32rpx; }.hero-sample { width:54rpx; height:40rpx; border-radius:9rpx; background:linear-gradient(135deg,#4d7795,#183a52); }.hero-sample.gradient { background:linear-gradient(135deg,var(--primary),var(--hero-end)); }.corner-sample { width:50rpx; height:40rpx; border:3rpx solid currentColor; border-radius:15rpx; }.corner-sample.compact { border-radius:6rpx; }.large-text { font-size:27rpx; }
.preview-block + .preview-block { margin-top:26rpx; }.preview-label { margin-bottom:12rpx; color:var(--muted); font-size:20rpx; font-weight:650; }.gallery-row { display:flex; align-items:center; gap:14rpx; margin-top:20rpx; }.gallery-actions { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:14rpx; width:100%; margin-top:20rpx; }.setting-row,.venue-choice { display:flex; align-items:center; justify-content:space-between; min-height:82rpx; border-top:1rpx solid var(--border); }.setting-row > view { flex:1; min-width:0; }.hint { margin-top:5rpx; color:var(--muted); font-size:20rpx; }.order-row { display:grid; grid-template-columns:auto minmax(0,1fr) auto auto; align-items:center; gap:10rpx; min-height:82rpx; border-top:1rpx solid var(--border); }.order-name { min-width:0; overflow:hidden; font-size:24rpx; text-overflow:ellipsis; white-space:nowrap; }.order-row button { width:auto; max-width:100%; height:54rpx; margin:0; padding:0 17rpx; border:0; border-radius:14rpx; background:var(--page-bg); color:var(--primary); font-size:20rpx; }.venue-choice { padding:0 6rpx; color:var(--muted); font-size:23rpx; }.venue-choice.selected { color:var(--primary); font-weight:650; }
.save-dock { position:fixed; right:0; bottom:0; left:0; z-index:20; box-sizing:border-box; padding:14rpx 32rpx calc(18rpx + env(safe-area-inset-bottom)); border-top:1rpx solid var(--border); background:rgba(255,255,255,.94); box-shadow:0 -12rpx 34rpx rgba(20,45,70,.1); backdrop-filter:blur(18px); }.mode-dark .save-dock { background:rgba(27,30,34,.95); }.save-status { display:flex; align-items:center; justify-content:center; margin-bottom:11rpx; color:var(--muted); font-size:19rpx; }.status-dot { width:12rpx; height:12rpx; margin-right:8rpx; border-radius:50%; background:#34c759; }.status-dot.dirty { background:#ff9f0a; }.actions { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:16rpx; width:100%; }
@media (max-width:360px) { .appearance-page { padding-right:24rpx; padding-left:24rpx; }.section { padding:24rpx; }.order-row { grid-template-columns:auto minmax(0,1fr); padding:12rpx 0; }.order-row button { width:100%; }.order-row button:first-of-type { grid-column:1; }.order-row button:last-of-type { grid-column:2; }.preset-grid { display:grid; grid-template-columns:1fr; }.choice-row.three { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); }.save-dock { padding-right:24rpx; padding-left:24rpx; } }
