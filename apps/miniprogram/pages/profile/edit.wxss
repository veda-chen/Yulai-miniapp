.page {
  padding: 32rpx;
}

.card {
  padding: 32rpx;
  border: var(--surface-border-width) solid var(--border);
  border-radius: var(--surface-radius);
  background: var(--surface);
  box-shadow: var(--surface-shadow);
}

.form,
.field {
  display: flex;
  flex-direction: column;
}

.avatar-field {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 34rpx;
}

.avatar-picker {
  position: relative;
  display: block;
  flex: 0 0 168rpx;
  overflow: hidden;
  box-sizing: border-box;
  width: 168rpx;
  min-width: 168rpx;
  max-width: 168rpx;
  height: 168rpx;
  min-height: 168rpx;
  max-height: 168rpx;
  margin: 0;
  padding: 0;
  border: 6rpx solid var(--surface);
  border-radius: 50%;
  background: linear-gradient(135deg, #cfe5ff, #2e8dff);
  box-shadow: 0 10rpx 28rpx rgba(0, 122, 255, 0.18);
}

.avatar-picker::after,
.remove-avatar::after {
  border: 0;
}

.avatar-image,
.avatar-fallback {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}

.avatar-image {
  border-radius: 50%;
}

.avatar-fallback {
  color: #ffffff;
  font-size: 58rpx;
  font-weight: 750;
}

.avatar-action {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 44rpx;
  background: rgba(0, 0, 0, 0.46);
  color: #ffffff;
  font-size: 20rpx;
  line-height: 44rpx;
}

.avatar-help {
  margin-top: 14rpx;
  color: var(--muted);
  font-size: 22rpx;
}

.remove-avatar {
  width: auto;
  margin: 10rpx 0 0;
  padding: 0 18rpx;
  background: transparent;
  color: #d93025;
  font-size: 22rpx;
  line-height: 1.8;
}

.field + .field {
  margin-top: 30rpx;
}

.label {
  margin-bottom: 12rpx;
  color: var(--text);
  font-size: 26rpx;
}

input,
.picker-value {
  box-sizing: border-box;
  border: 1rpx solid var(--border);
  border-radius: 14rpx;
  background: var(--page-bg);
  color: var(--text);
  font-size: 30rpx;
}

input {
  width: 100%;
  height: 92rpx;
  min-height: 92rpx;
  padding: 0 20rpx;
  line-height: 92rpx;
}

input.invalid { border-color:#d93025; background:rgba(217,48,37,.05); }
.field-error { margin-top:8rpx; color:#d93025; font-size:21rpx; }

.picker-value {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 92rpx;
  padding: 18rpx 20rpx;
  text-align: center;
}

.save {
  margin-top: 40rpx;
  border: 2rpx solid var(--button-primary-border);
  background: var(--button-primary-bg);
  color: #ffffff;
  box-shadow: var(--button-shadow);
}
.save[disabled] { border-color:var(--border); background:var(--page-bg); color:var(--muted); box-shadow:none; }

.message {
  margin-top: 18rpx;
  color: var(--muted);
  font-size: 24rpx;
  text-align: center;
}

.remove-avatar {
  box-sizing: border-box;
  height: 56rpx;
  padding: 0 18rpx;
}

.save {
  box-sizing: border-box;
  height: 88rpx;
  padding: 0 28rpx;
}
