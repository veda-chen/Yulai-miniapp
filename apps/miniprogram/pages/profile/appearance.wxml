<view class="appearance-page {{appearanceClass}}">
  <view class="intro"><text class="eyebrow">PERSONALIZE · 个性化</text><text class="title">让羽来更有你的风格</text><text class="copy">所有调整先在本页预览，保存后应用到小程序。</text></view>

  <view class="section surface"><view class="section-heading"><view class="section-mark"></view><view><text class="section-title">风格方案</text><text class="section-copy">一键应用常用组合，不影响首页模块和同步设置</text></view></view>
    <view class="preset-grid">
      <button class="preset blue {{presetId === 'blue-active' ? 'selected' : ''}}" data-id="blue-active" bindtap="applyPreset"><view class="preset-art"><view class="preset-ball"></view><view class="preset-line"></view></view><text class="preset-name">蓝色活力</text><text class="preset-copy">照片封面 · 舒适卡片</text></button>
      <button class="preset green {{presetId === 'green-court' ? 'selected' : ''}}" data-id="green-court" bindtap="applyPreset"><view class="preset-art court"><view class="preset-ball"></view><view class="preset-line"></view></view><text class="preset-name">绿色球场</text><text class="preset-copy">渐变封面 · 球场计分</text></button>
      <button class="preset orange {{presetId === 'orange-light' ? 'selected' : ''}}" data-id="orange-light" bindtap="applyPreset"><view class="preset-art"><view class="preset-ball"></view><view class="preset-line"></view></view><text class="preset-name">橙色轻快</text><text class="preset-copy">紧凑卡片 · 简洁圆角</text></button>
    </view>
  </view>

  <view class="section surface quick-preview"><view class="section-heading"><view class="section-mark"></view><view><text class="section-title">当前方案 · {{presetName}}</text><text class="section-copy">先看效果，再决定是否细调</text></view></view><view class="quick-preview-row"><status-chip label="报名中" tone="success" /><status-chip label="候补" tone="warning" /><ui-button label="创建球局" variant="primary" readonly="{{true}}" /></view><text class="label">明暗模式</text><view class="choice-row three"><button class="choice {{draft.colorMode === 'light' ? 'selected' : ''}}" data-field="colorMode" data-value="light" bindtap="choose">浅色</button><button class="choice {{draft.colorMode === 'dark' ? 'selected' : ''}}" data-field="colorMode" data-value="dark" bindtap="choose">深色</button><button class="choice {{draft.colorMode === 'system' ? 'selected' : ''}}" data-field="colorMode" data-value="system" bindtap="choose">跟随系统</button></view><text class="label">文字大小</text><view class="choice-row"><button class="choice {{draft.textSize === 'standard' ? 'selected' : ''}}" data-field="textSize" data-value="standard" bindtap="choose">标准</button><button class="choice {{draft.textSize === 'large' ? 'selected' : ''}}" data-field="textSize" data-value="large" bindtap="choose">大号</button></view><button class="advanced-toggle" bindtap="toggleAdvanced" aria-expanded="{{showAdvanced}}">{{showAdvanced ? '收起高级设置' : '展开高级设置'}} {{showAdvanced ? '⌃' : '⌄'}}</button></view>

  <block wx:if="{{showAdvanced}}">

  <view class="section surface"><view class="section-heading"><view class="section-mark"></view><view><text class="section-title">外观细调</text><text class="section-copy">在方案基础上继续调整</text></view></view>
    <text class="label">品牌配色</text><view class="choice-row three"><button class="choice {{draft.brand === 'blue' ? 'selected' : ''}}" data-field="brand" data-value="blue" bindtap="choose"><view class="swatch blue"></view><text>羽来蓝</text></button><button class="choice {{draft.brand === 'green' ? 'selected' : ''}}" data-field="brand" data-value="green" bindtap="choose"><view class="swatch green"></view><text>球场绿</text></button><button class="choice {{draft.brand === 'orange' ? 'selected' : ''}}" data-field="brand" data-value="orange" bindtap="choose"><view class="swatch orange"></view><text>暖阳橙</text></button></view>
    <text class="label">明暗模式</text><view class="choice-row three"><button class="choice {{draft.colorMode === 'light' ? 'selected' : ''}}" data-field="colorMode" data-value="light" bindtap="choose">浅色</button><button class="choice dark-choice {{draft.colorMode === 'dark' ? 'selected' : ''}}" data-field="colorMode" data-value="dark" bindtap="choose">深色</button><button class="choice {{draft.colorMode === 'system' ? 'selected' : ''}}" data-field="colorMode" data-value="system" bindtap="choose">跟随系统</button></view>
    <text class="label">球局卡片</text><view class="choice-row"><button class="choice sample-choice {{draft.activityDensity === 'comfortable' ? 'selected' : ''}}" data-field="activityDensity" data-value="comfortable" bindtap="choose"><view class="density-sample comfortable"><view></view><view></view></view><text>舒适</text></button><button class="choice sample-choice {{draft.activityDensity === 'compact' ? 'selected' : ''}}" data-field="activityDensity" data-value="compact" bindtap="choose"><view class="density-sample compact"><view></view><view></view></view><text>紧凑</text></button></view>
    <text class="label">首页封面</text><view class="choice-row"><button class="choice sample-choice {{draft.heroStyle === 'photo' ? 'selected' : ''}}" data-field="heroStyle" data-value="photo" bindtap="choose"><view class="hero-sample photo"></view><text>场景照片</text></button><button class="choice sample-choice {{draft.heroStyle === 'gradient' ? 'selected' : ''}}" data-field="heroStyle" data-value="gradient" bindtap="choose"><view class="hero-sample gradient"></view><text>品牌渐变</text></button></view>
    <text class="label">组件圆角</text><view class="choice-row"><button class="choice sample-choice {{draft.cornerStyle === 'rounded' ? 'selected' : ''}}" data-field="cornerStyle" data-value="rounded" bindtap="choose"><view class="corner-sample rounded"></view><text>圆润</text></button><button class="choice sample-choice {{draft.cornerStyle === 'compact' ? 'selected' : ''}}" data-field="cornerStyle" data-value="compact" bindtap="choose"><view class="corner-sample compact"></view><text>简洁</text></button></view>
    <text class="label">组件文字</text><view class="choice-row"><button class="choice {{draft.textSize === 'standard' ? 'selected' : ''}}" data-field="textSize" data-value="standard" bindtap="choose">标准</button><button class="choice large-text {{draft.textSize === 'large' ? 'selected' : ''}}" data-field="textSize" data-value="large" bindtap="choose">大号</button></view>
    <text class="label">计分板</text><view class="choice-row"><button class="choice {{draft.scoreTheme === 'default' ? 'selected' : ''}}" data-field="scoreTheme" data-value="default" bindtap="choose">默认</button><button class="choice {{draft.scoreTheme === 'court' ? 'selected' : ''}}" data-field="scoreTheme" data-value="court" bindtap="choose">球场风格</button></view>
  </view>

  <view class="section surface"><view class="section-heading"><view class="section-mark"></view><view><text class="section-title">组件风格</text><text class="section-copy">分别调整页面与常用组件</text></view></view>
    <text class="label">页面背景</text><view class="choice-row three"><button class="choice {{draft.pageBackground === 'plain' ? 'selected' : ''}}" data-field="pageBackground" data-value="plain" bindtap="choose">纯色</button><button class="choice {{draft.pageBackground === 'soft-gradient' ? 'selected' : ''}}" data-field="pageBackground" data-value="soft-gradient" bindtap="choose">柔和渐变</button><button class="choice {{draft.pageBackground === 'court-lines' ? 'selected' : ''}}" data-field="pageBackground" data-value="court-lines" bindtap="choose">球场线条</button></view>
    <text class="label">卡片层次</text><view class="choice-row three"><button class="choice {{draft.surfaceStyle === 'elevated' ? 'selected' : ''}}" data-field="surfaceStyle" data-value="elevated" bindtap="choose">悬浮</button><button class="choice {{draft.surfaceStyle === 'flat' ? 'selected' : ''}}" data-field="surfaceStyle" data-value="flat" bindtap="choose">扁平</button><button class="choice {{draft.surfaceStyle === 'outline' ? 'selected' : ''}}" data-field="surfaceStyle" data-value="outline" bindtap="choose">描边</button></view>
    <text class="label">按钮样式</text><view class="choice-row three"><button class="choice {{draft.buttonStyle === 'filled' ? 'selected' : ''}}" data-field="buttonStyle" data-value="filled" bindtap="choose">实色</button><button class="choice {{draft.buttonStyle === 'soft' ? 'selected' : ''}}" data-field="buttonStyle" data-value="soft" bindtap="choose">柔和</button><button class="choice {{draft.buttonStyle === 'outline' ? 'selected' : ''}}" data-field="buttonStyle" data-value="outline" bindtap="choose">描边</button></view>
    <text class="label">栏目标题</text><view class="choice-row three"><button class="choice {{draft.sectionStyle === 'marker' ? 'selected' : ''}}" data-field="sectionStyle" data-value="marker" bindtap="choose">品牌标记</button><button class="choice {{draft.sectionStyle === 'numbered' ? 'selected' : ''}}" data-field="sectionStyle" data-value="numbered" bindtap="choose">编号</button><button class="choice {{draft.sectionStyle === 'plain' ? 'selected' : ''}}" data-field="sectionStyle" data-value="plain" bindtap="choose">纯文字</button></view>
    <text class="label">图标容器</text><view class="choice-row three"><button class="choice {{draft.iconStyle === 'tile' ? 'selected' : ''}}" data-field="iconStyle" data-value="tile" bindtap="choose">彩色方块</button><button class="choice {{draft.iconStyle === 'circle' ? 'selected' : ''}}" data-field="iconStyle" data-value="circle" bindtap="choose">圆形</button><button class="choice {{draft.iconStyle === 'bare' ? 'selected' : ''}}" data-field="iconStyle" data-value="bare" bindtap="choose">无容器</button></view>
    <text class="label">界面动效</text><view class="choice-row"><button class="choice {{draft.motionMode === 'subtle' ? 'selected' : ''}}" data-field="motionMode" data-value="subtle" bindtap="choose">轻动效</button><button class="choice {{draft.motionMode === 'reduced' ? 'selected' : ''}}" data-field="motionMode" data-value="reduced" bindtap="choose">减少动效</button></view>
  </view>

  <view class="section preview-section surface"><view class="section-heading"><view class="section-mark"></view><view><text class="section-title">实时预览</text><text class="section-copy">以下均为示例，不会报名或修改比分</text></view></view>
    <view class="preview-block"><text class="preview-label">组件画廊</text><section-header title="本周推荐" description="真实组件的只读预览" action-text="查看更多" index="01" readonly="{{true}}" /><view class="gallery-row"><ui-icon text="羽" tone="primary" /><ui-icon text="场" tone="green" /><status-chip label="报名中" tone="success" /><status-chip label="候补" tone="warning" /></view><view class="gallery-actions"><ui-button label="主要操作" variant="primary" bind:action="previewPrimaryAction" /><ui-button label="次要操作" variant="secondary" bind:action="previewSecondaryAction" /></view></view>
    <view wx:if="{{draft.showHero}}" class="preview-block"><text class="preview-label">首页封面</text><hero-banner hero-style="{{draft.heroStyle}}" title="想打球，羽来就来" description="找球友、开球局，下一场就在附近" readonly="{{true}}" /></view>
    <view class="preview-block"><text class="preview-label">球局卡片</text><activity-card title="周五晚羽毛球局" time="周五 19:00" date="9月18日" venue="广东工业大学大学城校区体育馆 7 号场" organizer="羽仔" level="进阶局" count-text="4/6 人" status="已报名" density="{{draft.activityDensity}}" readonly="{{true}}" /></view>
    <view class="preview-block"><text class="preview-label">计分板</text><score-board name-a="A方" name-b="B方" score-a="18" score-b="16" score-theme="{{draft.scoreTheme}}" readonly="{{true}}" /></view>
  </view>

  <view class="section surface"><view class="section-heading"><view class="section-mark"></view><view><text class="section-title">首页布局</text><text class="section-copy">核心区域“我的球局 → 找球局”保持固定</text></view></view>
    <view class="setting-row"><view><text>首页封面</text><text class="hint">隐藏后仍保留创建球局入口</text></view><switch checked="{{draft.showHero}}" color="{{primaryColor}}" bindchange="toggleHero" /></view>
    <view wx:for="{{modules}}" wx:key="id" class="order-row"><switch checked="{{item.visible}}" color="{{primaryColor}}" data-id="{{item.id}}" bindchange="toggleModule" /><text class="order-name">{{item.label}}</text><button data-id="{{item.id}}" data-delta="-1" disabled="{{index === 0}}" bindtap="moveModule">上移</button><button data-id="{{item.id}}" data-delta="1" disabled="{{index === modules.length - 1}}" bindtap="moveModule">下移</button></view>
    <text class="label">工具顺序与首页展示（最多4项）</text><view wx:for="{{tools}}" wx:key="id" class="order-row"><switch checked="{{item.onHome}}" color="{{primaryColor}}" data-id="{{item.id}}" bindchange="toggleHomeTool" /><text class="order-name">{{item.label}}</text><button data-id="{{item.id}}" data-delta="-1" disabled="{{index === 0}}" bindtap="moveTool">上移</button><button data-id="{{item.id}}" data-delta="1" disabled="{{index === tools.length - 1}}" bindtap="moveTool">下移</button></view>
    <text class="label">常用场馆（最多3个）</text><view wx:if="{{venues.length === 0}}" class="hint">场馆列表暂时不可用</view><view wx:for="{{venues}}" wx:key="id" class="venue-choice {{item.selected ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="toggleVenue"><text>{{item.name}}</text><text>{{item.verificationStatus === 'UNAVAILABLE' ? '移除' : (item.selected ? '已选择' : '选择')}}</text></view>
  </view>

  <view class="section surface"><view class="section-heading"><view class="section-mark"></view><view><text class="section-title">同步设置</text><text class="section-copy">决定是否在其他设备使用相同外观</text></view></view><view class="setting-row"><view><text>云同步</text><text class="hint">{{syncMessage}}</text></view><switch checked="{{draft.syncEnabled}}" disabled="{{syncing}}" color="{{primaryColor}}" bindchange="toggleSync" /></view></view>

  </block>
  <view class="save-dock"><view class="save-status"><view class="status-dot {{hasUnsavedChanges ? 'dirty' : ''}}"></view><text>{{hasUnsavedChanges ? '有未保存修改' : '已保存'}}</text></view><view class="actions"><ui-button label="恢复默认" variant="secondary" bind:action="resetDraft" /><ui-button label="保存设置" variant="primary" loading="{{saving}}" disabled="{{saving || !hasUnsavedChanges}}" bind:action="save" /></view></view>
</view>
