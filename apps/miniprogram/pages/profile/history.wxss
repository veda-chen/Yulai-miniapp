.history-page { box-sizing:border-box; min-height:100vh; padding:30rpx 40rpx 70rpx; background:linear-gradient(180deg,#edf6ff,#f5f5f8 380rpx); }
.history-head { padding:20rpx 8rpx 34rpx; }.history-title,.history-copy { display:block; }.history-title { font-size:42rpx; font-weight:750; }.history-copy { margin-top:12rpx; color:var(--muted); font-size:24rpx; }
.history-list { display:flex; flex-direction:column; gap:20rpx; }.history-card { padding:28rpx 30rpx; }.card-head,.card-foot { display:flex; align-items:center; justify-content:space-between; gap:20rpx; }.card-title { flex:1; overflow:hidden; font-size:29rpx; font-weight:700; text-overflow:ellipsis; white-space:nowrap; }.status { flex:none; padding:6rpx 13rpx; border-radius:999rpx; background:var(--page-bg); color:var(--muted); font-size:20rpx; }.venue { display:block; margin-top:15rpx; overflow:hidden; color:var(--muted); font-size:24rpx; text-overflow:ellipsis; white-space:nowrap; }.card-foot { margin-top:22rpx; padding-top:20rpx; border-top:1rpx solid #ececf0; color:var(--muted); font-size:21rpx; }.participation { color:var(--primary); font-weight:650; }
.organizer { display:flex; align-items:center; min-width:0; margin-top:12rpx; color:var(--muted); font-size:21rpx; }.organizer text { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }.organizer-mark { flex:none; display:flex; align-items:center; justify-content:center; width:30rpx; height:30rpx; margin-right:9rpx; border-radius:50%; background:var(--primary-soft); color:var(--primary); font-size:16rpx; font-weight:750; }
.empty { display:flex; flex-direction:column; align-items:center; padding:64rpx 30rpx; color:var(--muted); font-size:25rpx; text-align:center; }.empty-title { color:var(--text); font-size:29rpx; font-weight:700; }.empty-copy { margin-top:10rpx; color:var(--muted); font-size:22rpx; }
.load-more { width:100%; height:72rpx; margin:20rpx 0; border:1rpx solid var(--border); border-radius:var(--control-radius); background:var(--surface); color:var(--primary); font-size:22rpx; }.load-more::after { border:0; }
.retry-button { width:220rpx; height:64rpx; margin:20rpx auto 0; border:0; border-radius:999rpx; background:var(--primary); color:#fff; font-size:22rpx; }.retry-button::after { border:0; }.load-message { margin-top:18rpx; padding:18rpx; border-radius:18rpx; background:var(--primary-soft); color:var(--primary); font-size:21rpx; text-align:center; }
