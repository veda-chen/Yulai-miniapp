.history-page { box-sizing:border-box; min-height:100vh; padding:30rpx 40rpx 70rpx; background:linear-gradient(180deg,#edf6ff,#f5f5f8 380rpx); }
.history-head { padding:20rpx 8rpx 34rpx; }.history-title,.history-copy { display:block; }.history-title { font-size:42rpx; font-weight:750; }.history-copy { margin-top:12rpx; color:#6e6e73; font-size:24rpx; }
.history-list { display:flex; flex-direction:column; gap:20rpx; }.history-card { padding:28rpx 30rpx; }.card-head,.card-foot { display:flex; align-items:center; justify-content:space-between; gap:20rpx; }.card-title { flex:1; overflow:hidden; font-size:29rpx; font-weight:700; text-overflow:ellipsis; white-space:nowrap; }.status { flex:none; padding:6rpx 13rpx; border-radius:999rpx; background:#f2f2f7; color:#6e6e73; font-size:20rpx; }.venue { display:block; margin-top:15rpx; overflow:hidden; color:#5f6b75; font-size:24rpx; text-overflow:ellipsis; white-space:nowrap; }.card-foot { margin-top:22rpx; padding-top:20rpx; border-top:1rpx solid #ececf0; color:#8e8e93; font-size:21rpx; }.participation { color:#007aff; font-weight:650; }
.empty { display:flex; flex-direction:column; align-items:center; padding:64rpx 30rpx; color:#6e6e73; font-size:25rpx; text-align:center; }.empty-title { color:#1d1d1f; font-size:29rpx; font-weight:700; }.empty-copy { margin-top:10rpx; color:#8e8e93; font-size:22rpx; }
