<view class="profile-page {{appearanceClass}}">
  <view class="profile-header"><view class="profile-avatar"><user-avatar src="{{avatarFileId}}" name="{{nickname}}" size="180" /></view><text class="nickname">{{nickname}}</text><view class="meta-line"><text>{{schoolName}}</text><text class="dot">·</text><text class="level">{{levelText}}</text></view></view>
  <view class="stats surface"><view class="stat"><text class="num">{{upcomingCount}}</text><text class="stat-label">即将参加</text></view><view class="stat"><text class="num">{{organizingCount}}</text><text class="stat-label">正在组织</text></view><view class="stat"><text class="num">{{gameCount}}</text><text class="stat-label">锁定对局</text></view></view>
  <view class="menu surface">
    <navigator class="menu-item" url="/pages/profile/history"><view><ui-icon src="/assets/icons/menu/calendar.svg" tone="neutral" /><text>参加记录</text></view><image class="chevron-icon" src="/assets/icons/menu/chevron-right.svg" /></navigator>
    <navigator class="menu-item" url="/pages/profile/edit"><view><ui-icon src="/assets/icons/menu/edit.svg" tone="neutral" /><text>编辑个人资料</text></view><image class="chevron-icon" src="/assets/icons/menu/chevron-right.svg" /></navigator>
    <navigator class="menu-item" url="/pages/profile/appearance"><view><ui-icon text="Aa" tone="primary" /><text>个性化设置</text></view><image class="chevron-icon" src="/assets/icons/menu/chevron-right.svg" /></navigator>
    <navigator class="menu-item" url="/pages/notifications/list"><view><ui-icon src="/assets/icons/menu/message.svg" tone="neutral" /><text>消息通知</text></view><image class="chevron-icon" src="/assets/icons/menu/chevron-right.svg" /></navigator>
  </view>
  <view class="menu surface">
    <navigator class="menu-item" url="/pages/privacy/index"><view><ui-icon src="/assets/icons/menu/shield.svg" tone="neutral" /><text>隐私与数据</text></view><image class="chevron-icon" src="/assets/icons/menu/chevron-right.svg" /></navigator>
    <navigator class="menu-item" url="/pages/reports/form?type=USER&id=self"><view><ui-icon src="/assets/icons/menu/help.svg" tone="neutral" /><text>帮助与反馈</text></view><image class="chevron-icon" src="/assets/icons/menu/chevron-right.svg" /></navigator>
    <navigator wx:if="{{isAdmin}}" class="menu-item" url="/pages/admin/index"><view><ui-icon src="/assets/icons/menu/admin.svg" tone="primary" /><text>运营管理</text></view><image class="chevron-icon" src="/assets/icons/menu/chevron-right.svg" /></navigator>
  </view>
  <button class="delete-account" loading="{{deleting}}" bindtap="deleteAccount">注销账号</button>
  <text class="version">羽来 Yulai · M5</text>
</view>
