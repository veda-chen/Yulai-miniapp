<view class="profile-page">
  <view class="profile-header"><view class="avatar"><image wx:if="{{avatarFileId}}" class="avatar-image" src="{{avatarFileId}}" mode="aspectFill" /><text wx:else>{{initial}}</text></view><text class="nickname">{{nickname}}</text><view class="meta-line"><text>{{schoolName}}</text><text class="dot">·</text><text class="level">{{levelText}}</text></view></view>
  <view class="stats surface"><view class="stat"><text class="num">{{upcomingCount}}</text><text class="stat-label">即将参加</text></view><view class="stat"><text class="num">{{organizingCount}}</text><text class="stat-label">正在组织</text></view><view class="stat"><text class="num">{{gameCount}}</text><text class="stat-label">锁定对局</text></view></view>
  <view class="menu surface">
    <navigator open-type="switchTab" class="menu-item" url="/pages/activities/list"><view><view class="menu-icon blue"><image src="/assets/icons/menu/calendar.svg" /></view><text>我的球局</text></view><image class="chevron-icon" src="/assets/icons/menu/chevron-right.svg" /></navigator>
    <navigator class="menu-item" url="/pages/profile/edit"><view><view class="menu-icon gray"><image src="/assets/icons/menu/edit.svg" /></view><text>编辑个人资料</text></view><image class="chevron-icon" src="/assets/icons/menu/chevron-right.svg" /></navigator>
    <navigator class="menu-item" url="/pages/notifications/list"><view><view class="menu-icon gray"><image src="/assets/icons/menu/message.svg" /></view><text>消息通知</text></view><image class="chevron-icon" src="/assets/icons/menu/chevron-right.svg" /></navigator>
  </view>
  <view class="menu surface">
    <navigator class="menu-item" url="/pages/privacy/index"><view><view class="menu-icon gray"><image src="/assets/icons/menu/shield.svg" /></view><text>隐私与数据</text></view><image class="chevron-icon" src="/assets/icons/menu/chevron-right.svg" /></navigator>
    <navigator class="menu-item" url="/pages/reports/form?type=USER&id=self"><view><view class="menu-icon gray"><image src="/assets/icons/menu/help.svg" /></view><text>帮助与反馈</text></view><image class="chevron-icon" src="/assets/icons/menu/chevron-right.svg" /></navigator>
    <navigator wx:if="{{isAdmin}}" class="menu-item" url="/pages/admin/index"><view><view class="menu-icon blue"><image src="/assets/icons/menu/admin.svg" /></view><text>运营管理</text></view><image class="chevron-icon" src="/assets/icons/menu/chevron-right.svg" /></navigator>
  </view>
  <button class="delete-account" loading="{{deleting}}" bindtap="deleteAccount">注销账号</button>
  <text class="version">羽来 Yulai · M5</text>
</view>
