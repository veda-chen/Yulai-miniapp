.privacy-page { box-sizing:border-box; min-height:100vh; padding:40rpx 32rpx 64rpx; background:#f2f2f7; }
.intro { display:flex; flex-direction:column; padding:12rpx 8rpx 34rpx; }
.eyebrow { color:#007aff; font-size:23rpx; font-weight:650; letter-spacing:1rpx; }
.title { margin-top:10rpx; font-size:44rpx; font-weight:750; line-height:1.25; }
.summary { margin-top:14rpx; color:#6e6e73; font-size:26rpx; line-height:1.65; }
.section { margin-bottom:24rpx; padding:30rpx; }
.section-title { display:block; margin-bottom:22rpx; font-size:30rpx; font-weight:700; }
.row { display:flex; align-items:flex-start; justify-content:space-between; gap:24rpx; padding:19rpx 0; border-top:1rpx solid #e5e5ea; font-size:26rpx; }
.row:first-of-type { border-top:0; }
.label { color:#6e6e73; }
.value, .link { text-align:right; }
.link { color:#007aff; }
.item { display:flex; flex-direction:column; padding:22rpx 0; border-top:1rpx solid #e5e5ea; }
.item:first-of-type { padding-top:0; border-top:0; }
.item:last-child { padding-bottom:0; }
.item-title { font-size:27rpx; font-weight:650; }
.item-body, .paragraph { margin-top:10rpx; color:#636366; font-size:25rpx; line-height:1.75; }
.paragraph { display:block; }
.paragraph:first-of-type { margin-top:0; }
.notice { padding:10rpx 8rpx 0; color:#8e8e93; font-size:21rpx; text-align:center; }
