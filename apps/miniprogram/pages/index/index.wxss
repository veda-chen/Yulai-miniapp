.home-page { min-height:100vh; box-sizing:border-box; padding:28rpx 40rpx 52rpx; background:#fff; }
.home-header { display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:36rpx; }
.eyebrow,.home-name,.home-date,.hero-title,.hero-copy,.activity-time,.activity-date,.activity-title,.activity-venue { display:block; }
.eyebrow { color:#6e6e73; font-size:24rpx; font-weight:500; margin-bottom:6rpx; }
.home-name { color:#1d1d1f; font-size:54rpx; font-weight:700; line-height:1.08; letter-spacing:-2rpx; }
.home-date { color:#6e6e73; font-size:24rpx; margin-top:10rpx; }
.notify { position:relative; display:flex; align-items:center; justify-content:center; width:80rpx; height:80rpx; border:1rpx solid #e5e5ea; border-radius:50%; background:#f7f7fa; }
.notify-icon { color:#1d1d1f; font-size:30rpx; }.notify-dot { position:absolute; top:13rpx; right:13rpx; width:14rpx; height:14rpx; border:4rpx solid #fff; border-radius:50%; background:#ff3b30; }
.hero { position:relative; overflow:hidden; min-height:350rpx; border-radius:38rpx; background:#244756; box-shadow:0 14rpx 40rpx rgba(0,0,0,.13); }
.hero-image { position:absolute; inset:0; width:100%; height:100%; }
.hero-shade { position:absolute; inset:0; background:linear-gradient(135deg,rgba(15,40,55,.32),rgba(15,40,55,.74)); }.hero-content { position:relative; z-index:1; padding:46rpx; color:#fff; }
.hero-title { max-width:480rpx; font-size:44rpx; font-weight:700; line-height:1.24; }.hero-copy { width:520rpx; margin-top:18rpx; font-size:27rpx; line-height:1.55; opacity:.92; }
.hero-button { display:inline-flex; align-items:center; margin-top:34rpx; padding:0 36rpx; height:88rpx; border-radius:999rpx; background:#fff; color:#007aff; font-size:28rpx; font-weight:650; box-shadow:0 8rpx 24rpx rgba(0,0,0,.16); }.plus { margin-right:8rpx; font-size:36rpx; }
.section-head { display:flex; align-items:center; justify-content:space-between; margin:48rpx 0 24rpx; }.section-title { font-size:34rpx; font-weight:700; color:#1d1d1f; }.section-link { color:#007aff; font-size:25rpx; font-weight:600; }
.activity-scroll { width:calc(100vw - 40rpx); }.activity-track { display:flex; gap:22rpx; padding:2rpx 40rpx 10rpx 0; }.activity-card,.empty-card { flex:none; box-sizing:border-box; width:520rpx; min-height:250rpx; padding:30rpx; }
.activity-top { display:flex; align-items:flex-start; justify-content:space-between; }.activity-time { font-size:29rpx; font-weight:700; }.activity-date { margin-top:4rpx; color:#6e6e73; font-size:22rpx; }
.status-pill { padding:8rpx 18rpx; border-radius:999rpx; background:#34c759; color:#fff; font-size:21rpx; font-weight:600; }.status-pill.waiting { background:#fff3d1; color:#9a6c00; }
.activity-title { margin-top:24rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:28rpx; font-weight:650; }.activity-venue { margin-top:14rpx; overflow:hidden; color:#6e6e73; font-size:25rpx; text-overflow:ellipsis; white-space:nowrap; }.activity-meta { display:flex; justify-content:space-between; margin-top:24rpx; color:#6e6e73; font-size:23rpx; }
.quick-head { margin-bottom:20rpx; }.quick-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:16rpx; }.quick-item { display:flex; flex-direction:column; align-items:center; gap:12rpx; color:#3c3c43; font-size:23rpx; }.quick-icon { display:flex; align-items:center; justify-content:center; width:94rpx; height:94rpx; border-radius:28rpx; background:#f2f2f7; color:#007aff; font-size:38rpx; }
.connection { display:block; margin-top:40rpx; color:#aeaeb2; font-size:21rpx; text-align:center; }
