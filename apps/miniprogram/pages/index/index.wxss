.home-page { box-sizing:border-box; min-height:100vh; padding:28rpx 40rpx 60rpx; background:linear-gradient(180deg,var(--surface) 0,var(--surface) 620rpx,var(--page-bg) 100%); color:var(--text); }
.home-header { display:flex; align-items:flex-start; justify-content:space-between; margin-bottom:36rpx; }.eyebrow,.home-name,.home-date,.find-title,.find-description { display:block; }.eyebrow { margin-bottom:6rpx; color:var(--primary); font-size:22rpx; font-weight:700; letter-spacing:2rpx; }.home-name { color:var(--text); font-size:54rpx; font-weight:780; line-height:1.08; letter-spacing:-2rpx; }.home-date { margin-top:10rpx; color:var(--muted); font-size:24rpx; }.notify { position:relative; display:flex; align-items:center; justify-content:center; width:80rpx; height:80rpx; border:1rpx solid var(--border); border-radius:50%; background:var(--surface); box-shadow:0 8rpx 24rpx rgba(20,55,90,.08); }.notify-icon { position:relative; box-sizing:border-box; width:31rpx; height:32rpx; border:4rpx solid var(--primary); border-radius:16rpx 16rpx 10rpx 10rpx; }.notify-icon::before { content:""; position:absolute; top:-9rpx; left:8rpx; width:7rpx; height:8rpx; border-radius:8rpx 8rpx 0 0; background:var(--primary); }.notify-clapper { position:absolute; right:7rpx; bottom:-9rpx; width:9rpx; height:5rpx; border-radius:0 0 8rpx 8rpx; background:var(--primary); }.notify-dot { position:absolute; top:13rpx; right:13rpx; width:14rpx; height:14rpx; border:4rpx solid var(--surface); border-radius:50%; background:#ff3b30; }
.create-strip,.venue-card { display:flex; align-items:center; justify-content:space-between; margin-top:22rpx; padding:26rpx 28rpx; color:var(--text); }.find-title { font-size:29rpx; font-weight:700; }.find-description { margin-top:7rpx; overflow:hidden; color:var(--muted); font-size:22rpx; text-overflow:ellipsis; white-space:nowrap; }.find-arrow { margin-left:16rpx; color:var(--primary); font-size:42rpx; }
.section-head { display:flex; align-items:center; justify-content:space-between; margin:48rpx 0 22rpx; }.section-heading { display:flex; align-items:center; min-width:0; }.section-mark { width:9rpx; height:34rpx; margin-right:14rpx; border-radius:999rpx; background:var(--primary); box-shadow:0 0 0 7rpx var(--primary-soft); }.section-title { color:var(--text); font-size:34rpx; font-weight:780; }.section-link { color:var(--primary); font-size:24rpx; font-weight:650; }.find-head { margin-bottom:18rpx; }
.activity-scroll { width:100%; }.activity-track { display:flex; box-sizing:border-box; width:100%; gap:22rpx; padding:2rpx 0 10rpx; }.swipe-hint { display:flex; align-items:center; justify-content:center; gap:12rpx; margin-top:10rpx; color:var(--muted); font-size:20rpx; }.swipe-hint text:first-child,.swipe-hint text:last-child { color:var(--primary); font-weight:750; }
.home-search { display:flex; align-items:center; box-sizing:border-box; height:86rpx; padding:0 24rpx; border:2rpx solid var(--border); border-radius:var(--control-radius); box-shadow:0 10rpx 28rpx rgba(30,55,84,.06); }.search-icon { flex:none; box-sizing:border-box; width:24rpx; height:24rpx; margin-right:20rpx; border:4rpx solid var(--primary); border-radius:50%; }.search-icon::after { content:""; display:block; width:13rpx; height:4rpx; margin:18rpx 0 0 17rpx; border-radius:4rpx; background:var(--primary); transform:rotate(45deg); }.home-search input { flex:1; height:82rpx; color:var(--text); font-size:26rpx; }.search-clear { flex:none; width:50rpx; height:50rpx; margin:0; padding:0; border:0; border-radius:50%; background:var(--primary-soft); color:var(--primary); font-size:32rpx; font-weight:600; }.search-clear::after { border:0; }.recommend-head { display:flex; align-items:center; justify-content:space-between; margin:24rpx 2rpx 16rpx; }.recommend-title { color:var(--text); font-size:25rpx; font-weight:700; }.result-count { padding:6rpx 14rpx; border-radius:999rpx; background:var(--primary-soft); color:var(--primary); font-size:20rpx; font-weight:650; }
.home-tool-list { display:flex; flex-direction:column; gap:18rpx; }.module-message { padding:28rpx; color:var(--muted); font-size:23rpx; line-height:1.5; }.venue-card + .venue-card { margin-top:14rpx; }.optional-module { margin-top:6rpx; }
.mode-dark.home-page { background:linear-gradient(180deg,#15181c 0,var(--page-bg) 700rpx); }.mode-dark .notify,.mode-dark .home-search { box-shadow:none; }
