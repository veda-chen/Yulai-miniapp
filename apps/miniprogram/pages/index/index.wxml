<view class="home-page {{appearanceClass}}">
  <view class="home-header"><view><text class="eyebrow">{{greeting}}</text><text class="home-name">{{userName}}</text><text class="home-date">{{dateText}}</text></view><navigator class="notify" url="/pages/notifications/list" aria-label="查看消息"><view class="notify-icon"><view class="notify-clapper"></view></view><view class="notify-dot"></view></navigator></view>
  <hero-banner wx:if="{{appearance.showHero}}" hero-style="{{appearance.heroStyle}}" />
  <navigator wx:else class="create-strip surface" url="/pages/activities/form"><view><text class="find-title">创建球局</text><text class="find-description">约上附近球友一起打球</text></view><text class="find-arrow">＋</text></navigator>
  <view class="section-head"><view class="section-heading"><view class="section-mark"></view><text class="section-title">我的球局</text></view><navigator class="section-link" url="/pages/profile/history">参加记录 ›</navigator></view>
  <scroll-view class="activity-scroll" scroll-x enhanced show-scrollbar="{{false}}"><view class="activity-track"><activity-card wx:for="{{activities}}" wx:key="id" url="/pages/activities/detail?id={{item.id}}" title="{{item.title}}" time="{{item.shortTime}}" date="{{item.shortDate}}" venue="{{item.venue.name}}" level="{{item.levelText}}" count-text="{{item.registeredCount}}/{{item.capacity}} 人" status="{{item.registrationText || '报名中'}}" waiting="{{item.currentRegistrationStatus === 'WAITLISTED'}}" density="{{appearance.activityDensity}}" /><empty-state wx:if="{{activities.length === 0}}" title="还没有参加的球局" description="报名后会在这里快速找到" url="/pages/activities/list" action-text="去找球局" /></view></scroll-view>
  <view wx:if="{{activities.length > 1}}" class="swipe-hint"><text>←</text><text>左右滑动查看更多</text><text>→</text></view>
  <view class="section-head find-head"><view class="section-heading"><view class="section-mark"></view><text class="section-title">找球局</text></view><navigator class="section-link" url="/pages/activities/list">查看全部 ›</navigator></view>
  <view class="home-search surface"><view class="search-icon"></view><input value="{{searchKeyword}}" placeholder="搜索球局、场馆或水平" confirm-type="search" bindinput="onSearchInput" /><button wx:if="{{searchKeyword}}" class="search-clear" bindtap="clearSearch">×</button></view>
  <view class="recommend-head"><text class="recommend-title">{{searchKeyword ? '搜索结果' : '推荐球局'}}</text><text wx:if="{{!recommendationsLoading && !recommendationsMessage}}" class="result-count">{{recommendedActivities.length}} 场</text></view>
  <scroll-view class="activity-scroll" scroll-x enhanced show-scrollbar="{{false}}"><view class="activity-track"><activity-card wx:for="{{recommendedActivities}}" wx:key="id" url="/pages/activities/detail?id={{item.id}}" title="{{item.title}}" time="{{item.shortTime}}" date="{{item.shortDate}}" venue="{{item.venue.name}}" level="{{item.levelText}}" count-text="{{item.registeredCount}}/{{item.capacity}} 人" status="{{item.registrationText}}" waiting="{{item.registeredCount >= item.capacity}}" density="{{appearance.activityDensity}}" /><empty-state wx:if="{{recommendationsLoading}}" title="正在寻找合适的球局" description="请稍候" /><empty-state wx:elif="{{recommendationsMessage}}" title="暂时无法加载球局" description="{{recommendationsMessage}}" action-text="重新加载" bind:action="retryRecommendations" /><empty-state wx:elif="{{recommendedActivities.length === 0 && searchKeyword}}" title="没有匹配的搜索结果" description="换个关键词试试，或清空搜索查看推荐" action-text="清空搜索" bind:action="clearSearch" /><empty-state wx:elif="{{recommendedActivities.length === 0}}" title="最近还没有公开球局" description="可以先创建一个，邀请附近球友参加" url="/pages/activities/form" action-text="创建球局" /></view></scroll-view>
  <view wx:if="{{recommendedActivities.length > 1}}" class="swipe-hint"><text>←</text><text>左右滑动查看更多</text><text>→</text></view>
  <block wx:for="{{homeModules}}" wx:key="id">
    <view wx:if="{{item.id === 'tools'}}" class="optional-module"><view class="section-head"><view class="section-heading"><view class="section-mark"></view><text class="section-title">快捷工具</text></view><navigator class="section-link" open-type="switchTab" url="/pages/tools/index">全部工具 ›</navigator></view><view class="home-tool-list"><tool-card wx:for="{{homeTools}}" wx:key="id" title="{{item.title}}" description="{{item.description}}" icon="{{item.icon}}" tone="{{item.tone}}" url="{{item.url}}" /></view></view>
    <view wx:if="{{item.id === 'venues'}}" class="optional-module"><view class="section-head"><view class="section-heading"><view class="section-mark"></view><text class="section-title">常用场馆</text></view><navigator class="section-link" open-type="switchTab" url="/pages/venues/list">场馆列表 ›</navigator></view><view wx:if="{{venueMessage}}" class="module-message surface">{{venueMessage}}</view><navigator wx:for="{{favoriteVenues}}" wx:key="id" class="venue-card surface" url="/pages/venues/detail?id={{item.id}}"><view><text class="find-title">{{item.name}}</text><text class="find-description">{{item.address || '地址待核验'}}</text></view><text class="find-arrow">›</text></navigator><view wx:if="{{!venueMessage && favoriteVenues.length === 0}}" class="module-message surface">请在“我的 → 个性化设置”中选择常用场馆</view></view>
  </block>
</view>
