<view class="home-page {{appearanceClass}}">
  <view class="home-header">
    <view class="home-greeting"><text class="home-date">{{dateText}}</text><text class="home-name">{{greeting}}，{{userName}} 👋</text></view>
    <navigator class="notify" url="/pages/notifications/list" aria-label="查看消息"><image class="notify-icon-image" src="/assets/icons/menu/message.svg" mode="aspectFit" /><view wx:if="{{hasUnread}}" class="notify-dot"></view></navigator>
  </view>

  <navigator wx:if="{{appearance.showHero}}" class="home-hero {{appearance.heroStyle === 'gradient' ? 'hero-gradient' : 'hero-photo'}}" url="/pages/activities/list">
    <image wx:if="{{appearance.heroStyle === 'photo'}}" class="hero-image" src="/assets/activity-header-v2.jpg" mode="aspectFill" /><view class="hero-shade"></view>
    <view class="hero-content"><text class="hero-tag">羽来 · 一起上场</text><text class="hero-title">找球局，马上开打</text><text class="hero-copy">看看附近谁在约球</text><view class="hero-link"><text class="hero-link-icon">›</text><text>去找球局</text></view></view>
  </navigator>
  <view class="quick-grid">
    <navigator class="quick-card quick-create" url="/pages/activities/form"><text class="quick-title">发起球局</text><text class="quick-copy">喊上球友，一起开场</text><text class="quick-arrow">↗</text><view class="quick-court"></view></navigator>
    <navigator class="quick-card quick-duck" url="/pages/tools/invitation"><text class="quick-title">打球鸭</text><text class="quick-copy">发到群里，问问谁来</text><text class="quick-arrow">↗</text><image class="quick-duck-art" src="/assets/home-duck.png" mode="aspectFit" /></navigator>
  </view>

  <view wx:if="{{activities.length > 0 || myActivitiesLoading || myActivitiesMessage}}" class="home-section">
    <view class="section-head"><text class="section-title">我的下一场</text><navigator class="section-link" url="/pages/profile/history">全部球局 ›</navigator></view>
    <navigator wx:if="{{activities.length > 0}}" class="next-card surface" url="/pages/activities/detail?id={{activities[0].id}}"><view class="next-date"><text class="next-day">{{activities[0].day}}</text><text class="next-weekday">{{activities[0].weekday}}</text></view><view class="next-copy"><text class="next-title">{{activities[0].title}}</text><text class="next-meta">{{activities[0].shortTime}} · {{activities[0].venue.name}}</text></view><text class="next-status {{activities[0].currentRegistrationStatus === 'WAITLISTED' ? 'is-waiting' : ''}}">{{activities[0].registrationText}}</text></navigator>
    <view wx:elif="{{myActivitiesLoading}}" class="home-message surface">正在加载我的球局…</view>
    <view wx:else class="home-message surface"><text>{{myActivitiesMessage}}</text><button bindtap="retryMyActivities">重试</button></view>
    <view wx:if="{{myActivitiesMessage && activities.length > 0}}" class="inline-status error"><text>我的球局刷新失败，已保留当前内容</text><button bindtap="retryMyActivities">重试</button></view>
  </view>

  <view class="home-section">
    <view class="section-head"><text class="section-title">{{displayedSearchKeyword ? '搜索结果' : '可加入的球局'}}</text><view class="section-actions"><button class="search-trigger" bindtap="toggleSearch" aria-label="搜索球局"><view class="search-glyph"></view></button><navigator class="section-link" url="/pages/activities/list">查看更多 ›</navigator></view></view>
    <view wx:if="{{searchExpanded}}" class="home-search surface"><view class="search-glyph"></view><input value="{{searchKeyword}}" maxlength="50" placeholder="搜索球局、场馆或水平" confirm-type="search" bindinput="onSearchInput" bindconfirm="confirmSearch" /><button wx:if="{{searchKeyword}}" class="search-clear" aria-label="清空搜索" bindtap="clearSearch">×</button></view>
    <view wx:if="{{recommendedActivities.length > 0}}" class="recommend-list">
      <block wx:for="{{recommendedActivities}}" wx:key="id"><navigator wx:if="{{index < 2}}" class="recommend-card surface" url="/pages/activities/detail?id={{item.id}}"><view class="recommend-icon">🏸</view><view class="recommend-copy"><text class="recommend-name">{{item.title}}</text><text class="recommend-meta">{{item.shortTime}} · {{item.venue.name}}</text><text class="recommend-status">{{item.registrationText}} · {{item.registeredCount}}/{{item.capacity}} 人</text></view><text class="recommend-chevron">›</text></navigator></block>
    </view>
    <view wx:elif="{{recommendationsLoading}}" class="home-message surface">正在寻找合适的球局…</view>
    <view wx:elif="{{recommendationsMessage}}" class="home-message surface"><text>{{recommendationsMessage}}</text><button bindtap="retryRecommendations">重试</button></view>
    <view wx:elif="{{searchKeyword}}" class="home-message surface"><text>没有匹配的球局，换个关键词试试</text><button bindtap="clearSearch">清空搜索</button></view>
    <navigator wx:else class="home-message home-empty surface" url="/pages/activities/form"><text>还没有球局，来发起第一场吧</text><text class="home-empty-arrow">＋</text></navigator>
    <view wx:if="{{recommendationsLoading && recommendedActivities.length > 0}}" class="inline-status">正在更新球局…</view>
    <view wx:if="{{recommendationsMessage && recommendedActivities.length > 0}}" class="inline-status error"><text>{{recommendationsMessage}}</text><button bindtap="retryRecommendations">重试</button></view>
    <button wx:if="{{displayedSearchKeyword && recommendationsNextOffset !== null}}" class="search-all-link" bindtap="openAllSearchResults">查看全部搜索结果 ›</button>
  </view>

  <block wx:for="{{homeModules}}" wx:key="id">
    <view wx:if="{{item.id === 'tools'}}" class="optional-module"><view class="section-head"><text class="section-title">快捷工具</text><navigator class="section-link" open-type="switchTab" url="/pages/tools/index">全部工具 ›</navigator></view><view class="home-tool-list"><tool-card wx:for="{{homeTools}}" wx:key="id" title="{{item.title}}" description="{{item.description}}" icon="{{item.icon}}" tone="{{item.tone}}" url="{{item.url}}" /></view></view>
    <view wx:if="{{item.id === 'venues'}}" class="optional-module"><view class="section-head"><text class="section-title">常用场馆</text><navigator class="section-link" open-type="switchTab" url="/pages/venues/list">场馆列表 ›</navigator></view><view wx:if="{{venueMessage}}" class="home-message surface">{{venueMessage}}</view><navigator wx:for="{{favoriteVenues}}" wx:key="id" class="venue-card surface" url="/pages/venues/detail?id={{item.id}}"><view><text class="venue-title">{{item.name}}</text><text class="venue-description">{{item.address || '地址待核验'}}</text></view><text class="venue-arrow">›</text></navigator><view wx:if="{{!venueMessage && favoriteVenues.length === 0}}" class="home-message surface">请在“我的 → 个性化设置”中选择常用场馆</view></view>
  </block>
</view>
