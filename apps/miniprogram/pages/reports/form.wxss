.page { min-height:100vh; box-sizing:border-box; padding:32rpx; background:linear-gradient(180deg,#eef8f5,#f5f7f6 420rpx); }
.card { padding:34rpx; border:1rpx solid rgba(25,113,94,.11); border-radius:28rpx; background:#fff; box-shadow:0 10rpx 28rpx rgba(25,74,61,.06); }.form-title,.form-copy { display:block; }.form-title { font-size:36rpx; font-weight:750; }.form-copy { margin-top:10rpx; color:#7a8782; font-size:22rpx; line-height:1.5; }
.label { display:block; margin:30rpx 0 13rpx; font-size:26rpx; font-weight:650; }.picker,textarea { box-sizing:border-box; width:100%; padding:22rpx; border:1rpx solid #d8e4df; border-radius:18rpx; background:#f9fbfa; }.picker { display:flex; justify-content:space-between; color:#32413c; }.picker text { color:#11866f; }textarea { min-height:240rpx; font-size:25rpx; line-height:1.55; }.counter { display:block; margin-top:8rpx; color:#9aa39f; font-size:20rpx; text-align:right; }.submit { margin-top:28rpx; border:0; border-radius:999rpx; background:#11866f; color:#fff; font-weight:650; }.submit::after { border:0; }
