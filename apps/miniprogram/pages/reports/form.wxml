<view class="page">
  <view class="card">
    <text class="form-title">{{pageTitle}}</text>
    <text class="form-copy">你提交的信息将进入运营审核，不会直接修改公开内容。</text>
    <text class="label">{{reasonLabel}}</text>
    <picker range="{{reasons}}" range-key="label" value="{{reasonIndex}}" bindchange="onReasonChange"><view class="picker">{{reasons[reasonIndex].label}} <text>›</text></view></picker>
    <text class="label">{{detailsLabel}}</text>
    <textarea maxlength="500" value="{{details}}" placeholder="{{placeholder}}" bindinput="onDetailsInput" />
    <text class="counter">{{details.length}} / 500</text>
    <button class="submit" loading="{{saving}}" bindtap="submit">{{submitText}}</button>
  </view>
</view>
