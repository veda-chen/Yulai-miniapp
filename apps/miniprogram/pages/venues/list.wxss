.venue-page { min-height:100vh; box-sizing:border-box; padding:24rpx 32rpx 60rpx; background:linear-gradient(180deg,#eef8f5 0,#f4f7f6 430rpx); }
.venue-banner { position:relative; overflow:hidden; height:300rpx; border-radius:36rpx; background:#0c4748; box-shadow:0 16rpx 38rpx rgba(10,65,67,.2); }.venue-banner-image,.venue-banner-shade { position:absolute; inset:0; width:100%; height:100%; }.venue-banner-shade { background:linear-gradient(90deg,rgba(3,28,34,.86) 0,rgba(3,35,40,.48) 62%,rgba(3,35,40,.06) 100%); }.venue-banner-content { position:relative; z-index:1; display:flex; flex-direction:column; justify-content:center; box-sizing:border-box; height:100%; padding:42rpx; color:#fff; }.venue-kicker { font-size:21rpx; font-weight:700; letter-spacing:4rpx; color:#75ead1; }.venue-title { display:block; width:410rpx; margin-top:16rpx; font-size:40rpx; font-weight:750; line-height:1.2; }.venue-subtitle { width:430rpx; margin-top:16rpx; font-size:23rpx; line-height:1.45; opacity:.82; }
.venue-section-head { display:flex; align-items:flex-end; justify-content:space-between; margin:38rpx 8rpx 22rpx; }.section-title,.section-copy { display:block; }.section-title { font-size:34rpx; font-weight:750; }.section-copy { margin-top:9rpx; color:#71807b; font-size:21rpx; }.venue-count { color:#11866f; font-size:23rpx; font-weight:650; }
.venue-card,.empty { margin-bottom:20rpx; border:1rpx solid rgba(25,113,94,.11); border-radius:28rpx; background:#fff; box-shadow:0 10rpx 28rpx rgba(25,74,61,.06); }.venue-card { display:flex; padding:28rpx; }.venue-mark { flex:none; display:flex; align-items:center; justify-content:center; width:92rpx; height:92rpx; margin-right:24rpx; border-radius:26rpx; background:linear-gradient(145deg,#dff7ef,#c9eee3); }.venue-pin { position:relative; width:34rpx; height:42rpx; border:5rpx solid #11866f; border-radius:50% 50% 50% 0; transform:rotate(-45deg); }.venue-pin view { position:absolute; top:9rpx; left:9rpx; width:9rpx; height:9rpx; border-radius:50%; background:#11866f; }.venue-main { flex:1; min-width:0; }.venue-head { display:flex; align-items:flex-start; justify-content:space-between; gap:16rpx; }.venue-name { flex:1; font-size:30rpx; font-weight:700; line-height:1.35; }.badge { flex:none; padding:6rpx 12rpx; border-radius:999rpx; background:#fff4d6; color:#835d0b; font-size:20rpx; }.venue-address { display:block; margin-top:10rpx; overflow:hidden; color:#66736e; font-size:24rpx; text-overflow:ellipsis; white-space:nowrap; }.venue-more { display:flex; justify-content:space-between; margin-top:19rpx; padding-top:16rpx; border-top:1rpx solid #eef2f0; color:#11866f; font-size:22rpx; font-weight:600; }
.empty { padding:60rpx 30rpx; color:#66736e; font-size:26rpx; text-align:center; }
