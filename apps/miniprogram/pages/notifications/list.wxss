.notification-page { min-height:100vh; box-sizing:border-box; padding:24rpx 32rpx 60rpx; background:linear-gradient(180deg,#edf6ff,#f6f7f9 420rpx); }.subscription-card { display:flex; align-items:center; gap:20rpx; padding:28rpx; border:1rpx solid rgba(20,122,243,.12); border-radius:30rpx; background:#fff; box-shadow:0 12rpx 30rpx rgba(30,72,110,.08); }.subscription-icon { flex:none; display:flex; align-items:center; justify-content:center; width:82rpx; height:82rpx; border-radius:24rpx; background:#e5f1ff; }.bell { position:relative; width:29rpx; height:31rpx; border:4rpx solid #147af3; border-radius:17rpx 17rpx 8rpx 8rpx; }.bell::before { content:""; position:absolute; top:-9rpx; left:10rpx; width:8rpx; height:8rpx; border-radius:50%; background:#147af3; }.bell::after { content:""; position:absolute; bottom:-10rpx; left:7rpx; width:15rpx; height:5rpx; border-radius:5rpx; background:#147af3; }.subscription-main { flex:1; min-width:0; }.subscription-title,.subscription-copy { display:block; }.subscription-title { font-size:28rpx; font-weight:700; }.subscription-copy { margin-top:7rpx; color:#71808a; font-size:21rpx; line-height:1.45; }.subscription-button { flex:0 0 118rpx; box-sizing:border-box; width:118rpx; height:64rpx; margin:0; padding:0; border:0; border-radius:999rpx; background:#147af3; color:#fff; font-size:22rpx; line-height:64rpx; }.subscription-button::after { border:0; }.state-ENABLED { border-color:rgba(17,134,111,.16); }.state-ENABLED .subscription-icon { background:#dff7ef; }.state-ENABLED .bell { border-color:#11866f; }.state-ENABLED .bell::before,.state-ENABLED .bell::after { background:#11866f; }.state-ENABLED .subscription-button { background:#11866f; }
.privacy-note { margin:14rpx 8rpx 30rpx; color:#8a959c; font-size:19rpx; line-height:1.5; }.section-head { display:flex; align-items:center; justify-content:space-between; margin:0 6rpx 18rpx; }.section-title { font-size:33rpx; font-weight:750; }.message-count { color:#71808a; font-size:21rpx; }
.item,.empty { display:flex; margin-bottom:18rpx; padding:28rpx; border:1rpx solid rgba(24,73,107,.08); border-radius:25rpx; background:#fff; box-shadow:0 8rpx 24rpx rgba(31,65,86,.05); }.empty { flex-direction:column; align-items:center; color:#74818a; text-align:center; }.empty-title { font-size:27rpx; font-weight:650; }.empty-copy { margin-top:8rpx; font-size:21rpx; }.item.read { opacity:.68; }.item-dot { flex:none; width:12rpx; height:12rpx; margin:12rpx 18rpx 0 0; border-radius:50%; background:#147af3; }.item.read .item-dot { background:#c8ced2; }.item-main { flex:1; min-width:0; }.title,.body,.time { display:block; }.title { font-size:28rpx; font-weight:650; }.body { margin-top:9rpx; color:#5f6e77; font-size:24rpx; line-height:1.5; }.time { margin-top:13rpx; color:#949da3; font-size:19rpx; }.chevron { align-self:center; margin-left:12rpx; color:#a3abb0; font-size:38rpx; }
