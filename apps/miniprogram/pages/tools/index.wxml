<view class="tools-page {{appearanceClass}}">
  <view class="tools-hero"><text class="hero-kicker">YULAI LAB</text><text class="hero-title">随开随用的球场工具</text><text class="hero-copy">无需创建球局，临时名单和比分只保留在当前页面。</text></view>
  <view class="section-head"><section-header title="快捷工具" description="无需发布球局" index="01" /></view>
  <view class="tool-list">
    <tool-card wx:for="{{tools}}" wx:key="id" title="{{item.title}}" description="{{item.description}}" icon="{{item.icon}}" tone="{{item.tone}}" badge="可用" url="{{item.url}}" />
  </view>
  <view class="ideas"><text class="ideas-title">本机临时数据</text><text class="draft-copy">公平组队、计分和费用草稿保留7天，不会上传云端。</text><button class="clear-drafts" bindtap="clearDrafts">清空全部临时数据</button></view>
</view>
