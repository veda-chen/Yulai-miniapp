@import "./common.wxss";
.version-card { margin-bottom:22rpx; padding:26rpx 28rpx; border:2rpx solid var(--primary); border-radius:var(--surface-radius); background:var(--primary-soft); }.version-head { display:flex; align-items:center; justify-content:space-between; }.version-title { color:var(--primary); font-size:27rpx; font-weight:750; }.version-copy { display:block; margin-top:12rpx; color:var(--text); font-size:22rpx; line-height:1.6; }.rule-item { display:flex; align-items:flex-start; margin-top:16rpx; font-size:23rpx; line-height:1.6; }.rule-dot { flex:none; width:10rpx; height:10rpx; margin:13rpx 16rpx 0 0; border-radius:50%; background:var(--primary); }.source { display:block; margin-top:18rpx; padding-top:18rpx; border-top:1rpx solid var(--border); color:var(--muted); font-size:19rpx; line-height:1.55; }
