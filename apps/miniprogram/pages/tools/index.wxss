.tools-page { box-sizing:border-box; min-height:100vh; padding:24rpx 40rpx 70rpx; background:linear-gradient(180deg,#eaf4ff 0,#f6f7f9 430rpx); }.tools-hero { padding:40rpx 38rpx; border-radius:36rpx; background:linear-gradient(135deg,#174f81,#147af3); color:#fff; box-shadow:0 14rpx 36rpx rgba(20,94,168,.2); }.hero-kicker,.hero-title,.hero-copy { display:block; }.hero-kicker { font-size:19rpx; font-weight:700; letter-spacing:4rpx; opacity:.72; }.hero-title { margin-top:14rpx; font-size:41rpx; font-weight:750; line-height:1.25; }.hero-copy { margin-top:14rpx; font-size:23rpx; line-height:1.55; opacity:.84; }.section-head { display:flex; align-items:center; justify-content:space-between; margin:36rpx 6rpx 20rpx; }.tool-list { display:flex; flex-direction:column; gap:18rpx; }.ideas { margin-top:30rpx; padding:28rpx 30rpx; border-radius:var(--surface-radius); background:var(--surface); box-shadow:var(--surface-shadow); }.ideas-title { display:block; font-size:27rpx; font-weight:700; }.draft-copy { display:block; margin-top:10rpx; color:var(--muted); font-size:22rpx; line-height:1.5; }.clear-drafts { height:68rpx; margin:22rpx 0 0; border:1rpx solid var(--border); border-radius:var(--control-radius); background:var(--surface); color:#d93025; font-size:23rpx; }.clear-drafts::after { border:0; }
.tools-page { padding-bottom:calc(170rpx + env(safe-area-inset-bottom)); }
.tools-page { background:var(--page-bg); color:var(--text); }
.tools-hero { padding:30rpx 32rpx; border-radius:var(--surface-radius); background:linear-gradient(120deg,var(--primary),var(--hero-end)); box-shadow:none; }
.tools-hero .hero-title { margin-top:8rpx; font-size:34rpx; }
.tools-hero .hero-copy { margin-top:8rpx; font-size:21rpx; }
.tools-page .section-head { margin-top:24rpx; }
.tool-list { gap:12rpx; }
.invite-entry { display:flex; align-items:center; justify-content:space-between; margin-top:22rpx; padding:26rpx 30rpx; border-radius:var(--surface-radius); background:#fff5d8; color:#6b4315; }
.invite-entry-title,.invite-entry-copy { display:block; }.invite-entry-title { font-size:27rpx; font-weight:700; }.invite-entry-copy { margin-top:7rpx; font-size:21rpx; }.invite-entry-arrow { font-size:42rpx; }
