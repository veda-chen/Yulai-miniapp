.tools-page { box-sizing:border-box; min-height:100vh; padding:24rpx 40rpx 70rpx; background:linear-gradient(180deg,#eaf4ff 0,#f6f7f9 430rpx); }.tools-hero { padding:40rpx 38rpx; border-radius:36rpx; background:linear-gradient(135deg,#174f81,#147af3); color:#fff; box-shadow:0 14rpx 36rpx rgba(20,94,168,.2); }.hero-kicker,.hero-title,.hero-copy { display:block; }.hero-kicker { font-size:19rpx; font-weight:700; letter-spacing:4rpx; opacity:.72; }.hero-title { margin-top:14rpx; font-size:41rpx; font-weight:750; line-height:1.25; }.hero-copy { margin-top:14rpx; font-size:23rpx; line-height:1.55; opacity:.84; }.section-head { display:flex; align-items:center; justify-content:space-between; margin:36rpx 6rpx 20rpx; }.section-title { font-size:32rpx; font-weight:750; }.section-note { color:#7d8992; font-size:20rpx; }.tool-list { display:flex; flex-direction:column; gap:18rpx; }.ideas { margin-top:30rpx; padding:28rpx 30rpx; border-radius:28rpx; background:rgba(255,255,255,.82); }.ideas-title { display:block; margin-bottom:12rpx; font-size:27rpx; font-weight:700; }.idea-row { display:flex; align-items:center; justify-content:space-between; gap:22rpx; padding:18rpx 0; border-bottom:1rpx solid #eceff2; font-size:23rpx; }.idea-row:last-child { border-bottom:0; }.idea-row text:first-child { flex:none; color:#263640; font-weight:650; }.idea-row text:last-child { color:#7b878e; text-align:right; }
