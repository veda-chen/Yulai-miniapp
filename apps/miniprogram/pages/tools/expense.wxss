@import "./common.wxss";
.expense-row { margin-top:18rpx; padding:20rpx; border:1rpx solid var(--border); border-radius:var(--control-radius); background:var(--page-bg); }.expense-grid { display:grid; grid-template-columns:1.2fr .8fr; gap:12rpx; }.expense-grid input { background:var(--surface); }.payer-row { display:flex; align-items:flex-end; gap:12rpx; margin-top:12rpx; }.payer-row picker { flex:1; }.remove-row { flex:none; width:100rpx; }.member-row,.transfer-row,.total-row { display:flex; align-items:center; justify-content:space-between; min-height:68rpx; border-bottom:1rpx solid var(--border); font-size:22rpx; }.member-row:last-child,.transfer-row:last-child { border-bottom:0; }.member-values { color:var(--muted); text-align:right; }.balance-positive { color:#14855e; }.balance-negative { color:#d65f27; }.total-row { margin-bottom:12rpx; font-size:27rpx; font-weight:750; }.transfer-row { align-items:flex-start; padding:12rpx 0; }.transfer-main { flex:1; }.transfer-amount { color:var(--primary); font-weight:750; }.rounding-note { display:block; margin-top:14rpx; color:var(--muted); font-size:19rpx; line-height:1.5; }
.tool-card > .button-row > button { box-sizing:border-box; height:76rpx; margin:0; padding:0 18rpx; line-height:76rpx; }
