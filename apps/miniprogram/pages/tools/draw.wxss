@import "./common.wxss";
.mode-grid { display:grid; grid-template-columns:1fr 1fr; gap:12rpx; margin-top:18rpx; }.mode-button { height:68rpx; margin:0; border:1rpx solid var(--border); border-radius:var(--control-radius); background:var(--surface); color:var(--muted); font-size:22rpx; }.mode-button.active { border-color:var(--primary); background:var(--primary-soft); color:var(--primary); font-weight:700; }.mode-button::after { border:0; }.result-line { display:block; margin-top:12rpx; padding:18rpx 20rpx; border-radius:var(--control-radius); background:var(--page-bg); font-size:24rpx; line-height:1.5; }.result-note { display:block; margin-top:16rpx; color:var(--muted); font-size:20rpx; }
