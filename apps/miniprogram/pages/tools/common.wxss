.tool-page { box-sizing:border-box; min-height:100vh; padding:28rpx 36rpx 80rpx; background:var(--page-background); color:var(--text); }.tool-intro { padding:18rpx 6rpx 28rpx; }.tool-kicker,.tool-title,.tool-copy { display:block; }.tool-kicker { color:var(--primary); font-size:18rpx; font-weight:700; letter-spacing:3rpx; }.tool-title { margin-top:10rpx; font-size:42rpx; font-weight:780; }.tool-copy { margin-top:11rpx; color:var(--muted); font-size:23rpx; line-height:1.55; }.tool-card { margin-bottom:22rpx; padding:28rpx; }.field-label { display:block; margin:22rpx 0 12rpx; color:var(--muted); font-size:22rpx; font-weight:650; }.field-input,.field-textarea,.picker-box { box-sizing:border-box; width:100%; border:1rpx solid var(--border); border-radius:var(--control-radius); background:var(--page-bg); color:var(--text); font-size:25rpx; }.field-input,.picker-box { min-height:76rpx; padding:0 20rpx; line-height:76rpx; }.field-textarea { height:210rpx; padding:20rpx; line-height:1.5; }.form-row { display:flex; gap:14rpx; }.form-row > view,.form-row > picker { flex:1; min-width:0; }.primary-action { box-sizing:border-box; width:100%; max-width:100%; height:82rpx; margin:24rpx 0 0; border:2rpx solid var(--button-primary-border); border-radius:var(--control-radius); background:var(--button-primary-bg); color:var(--button-primary-color); box-shadow:var(--button-shadow); font-size:26rpx; font-weight:700; }.secondary-action,.danger-action { box-sizing:border-box; max-width:100%; height:68rpx; margin:0; border:1rpx solid var(--border); border-radius:var(--control-radius); background:var(--surface); color:var(--primary); font-size:22rpx; }.danger-action { color:#d93025; }.primary-action::after,.secondary-action::after,.danger-action::after { border:0; }.button-row { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:14rpx; margin-top:18rpx; }.button-row button { width:100%; min-width:0; margin:0; }.muted { color:var(--muted); }.empty-copy { padding:34rpx 10rpx; color:var(--muted); font-size:23rpx; text-align:center; }.result-title { display:block; margin-bottom:18rpx; font-size:29rpx; font-weight:750; }.chip-row { display:flex; flex-wrap:wrap; gap:12rpx; }.name-chip { padding:9rpx 15rpx; border-radius:999rpx; background:var(--primary-soft); color:var(--primary); font-size:21rpx; }.privacy-copy { display:block; margin-top:20rpx; color:var(--muted); font-size:20rpx; line-height:1.55; text-align:center; }
@media (max-width:360px) { .tool-page { padding-right:24rpx; padding-left:24rpx; }.tool-card { padding:24rpx; }.form-row,.button-row { grid-template-columns:1fr; flex-direction:column; }.button-row button { width:100%; }.tool-title { font-size:38rpx; } }
