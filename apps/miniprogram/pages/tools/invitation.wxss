.invite-page { box-sizing:border-box; min-height:100vh; padding:38rpx 34rpx 100rpx; background:var(--page-bg); color:var(--text); }
.loading { padding:180rpx 20rpx; color:var(--muted); font-size:25rpx; text-align:center; }
.eyebrow { display:block; color:var(--primary); font-size:21rpx; font-weight:700; letter-spacing:3rpx; }.page-title { display:block; margin-top:14rpx; font-size:43rpx; font-weight:800; }.page-copy { display:block; margin-top:14rpx; color:var(--muted); font-size:24rpx; line-height:1.5; }
.preset-list { display:flex; flex-direction:column; gap:16rpx; margin-top:32rpx; }.preset { box-sizing:border-box; display:flex; align-items:center; justify-content:space-between; width:100%; min-height:126rpx; padding:20rpx 25rpx; margin:0; border:2rpx solid transparent; border-radius:26rpx; color:#203449; text-align:left; line-height:1.4; box-shadow:0 9rpx 22rpx rgba(30,55,84,.07); }.preset-cute { background:linear-gradient(115deg,#fff0d6,#fff9ec); }.preset-wild { background:linear-gradient(115deg,#e1eeff,#f2f8ff); }.preset-challenge { background:linear-gradient(115deg,#ddf2e8,#f2fbf6); }.preset.selected { border-color:var(--primary); box-shadow:0 12rpx 28rpx rgba(30,55,84,.13); }.preset::after { border:0; }.preset-copy { flex:1; min-width:0; }.preset-top { display:flex; align-items:center; gap:14rpx; }.preset-name { font-size:25rpx; font-weight:700; }.preset-selected { padding:3rpx 11rpx; border-radius:999rpx; background:var(--primary); color:#fff; font-size:17rpx; }.preset-line { margin-top:10rpx; font-size:23rpx; line-height:1.45; }.preset-art { display:flex; flex:none; align-items:center; justify-content:center; width:74rpx; height:74rpx; margin-left:18rpx; border:2rpx solid rgba(255,255,255,.7); border-radius:24rpx; background:rgba(255,255,255,.55); font-size:43rpx; }
.mode-dark .preset { color:var(--text); box-shadow:none; }.mode-dark .preset-cute { background:linear-gradient(115deg,#3a3024,#2a2925); }.mode-dark .preset-wild { background:linear-gradient(115deg,#25364b,#222b39); }.mode-dark .preset-challenge { background:linear-gradient(115deg,#233d35,#22322d); }.mode-dark .preset-art { border-color:rgba(255,255,255,.12); background:rgba(255,255,255,.08); }
.field-label { display:block; margin:30rpx 0 12rpx; color:var(--muted); font-size:22rpx; }.title-input { height:82rpx; padding:0 20rpx; border:1rpx solid var(--border); border-radius:20rpx; background:var(--surface); font-size:26rpx; }
.preview,.play-view { text-align:center; }.preview { margin-top:28rpx; padding:24rpx; border-radius:32rpx; background:linear-gradient(145deg,#d5f0ed,#e8f2ff 62%,#f2f7ff); color:#234a5b; }.preview-duck,.preview-title,.preview-line { display:block; }.preview-duck { font-size:88rpx; }.preview-title { font-size:34rpx; font-weight:800; }.preview-line { margin-top:8rpx; font-size:22rpx; }.mode-dark .preview { background:linear-gradient(145deg,#1c3d40,#27374d); color:var(--text); }
.main-button,.share-button { margin-top:30rpx; height:84rpx; line-height:84rpx; border-radius:22rpx; background:var(--button-primary-bg); color:var(--button-primary-color); font-size:26rpx; font-weight:700; text-align:center; }.main-button::after,.share-button::after { border:0; }
.play-view { padding:30rpx 25rpx 34rpx; border-radius:36rpx; background:var(--surface); box-shadow:var(--surface-shadow); }.duck-stage { position:relative; display:flex; align-items:center; justify-content:center; height:320rpx; margin:28rpx 0 22rpx; overflow:hidden; border-radius:32rpx; background:linear-gradient(145deg,#ccece8,#daeff8 54%,#e8e7fc); }.stage-sparkle { position:absolute; color:#fff; font-size:44rpx; }.sparkle-left { top:50rpx; left:50rpx; }.sparkle-right { right:58rpx; bottom:55rpx; font-size:56rpx; }.duck { position:relative; z-index:1; width:230rpx; height:230rpx; padding:0; margin:0; border:0; background:transparent; box-shadow:none; font-size:132rpx; line-height:230rpx; }.duck::after { border:0; }.mode-dark .duck-stage { background:linear-gradient(145deg,#1e4547,#243d52 56%,#373652); }.invite-title { display:block; font-size:43rpx; font-weight:800; }.invite-line { display:block; margin-top:15rpx; font-size:25rpx; line-height:1.5; }.tap-hint { display:block; margin:18rpx 0 22rpx; color:var(--muted); font-size:22rpx; }
.choice-list { display:flex; flex-direction:column; gap:14rpx; margin-top:20rpx; }.choice { box-sizing:border-box; display:flex; align-items:center; width:100%; min-height:112rpx; padding:16rpx 22rpx; margin:0; border:2rpx solid transparent; border-radius:24rpx; color:#23384b; text-align:left; line-height:1.3; }.choice::after { border:0; }.choice.yes { background:linear-gradient(110deg,#ddf4e8,#f2fbf5); }.choice.maybe { background:linear-gradient(110deg,#e3efff,#f3f8ff); }.choice.no { background:linear-gradient(110deg,#fff0df,#fff9ef); }.choice.chosen { border-color:var(--primary); box-shadow:0 7rpx 20rpx rgba(30,55,84,.1); }.choice-icon { display:flex; flex:none; align-items:center; justify-content:center; width:70rpx; height:70rpx; margin-right:20rpx; border-radius:20rpx; background:rgba(255,255,255,.65); font-size:38rpx; }.choice-copy { flex:1; min-width:0; }.choice-title,.choice-hint { display:block; }.choice-title { font-size:25rpx; font-weight:700; }.choice-hint { margin-top:7rpx; color:#62758a; font-size:19rpx; }.choice-end { margin-left:12rpx; color:var(--primary); font-size:32rpx; font-weight:700; }.mode-dark .choice { color:var(--text); }.mode-dark .choice.yes { background:linear-gradient(110deg,#223f34,#23332e); }.mode-dark .choice.maybe { background:linear-gradient(110deg,#25384e,#252f3e); }.mode-dark .choice.no { background:linear-gradient(110deg,#453526,#302b25); }.mode-dark .choice-icon { background:rgba(255,255,255,.08); }.mode-dark .choice-hint { color:var(--muted); }
.response-summary { margin-top:30rpx; font-size:23rpx; }.fine-print { display:block; margin-top:9rpx; color:var(--muted); font-size:19rpx; }.people { margin-top:28rpx; text-align:left; }.people-title { display:block; padding-bottom:10rpx; font-weight:700; }.person { display:flex; justify-content:space-between; padding:12rpx 0; border-top:1rpx solid var(--border); font-size:22rpx; }.create-activity { margin-top:23rpx; color:var(--primary); font-size:23rpx; }.plain-button { margin-top:14rpx; background:transparent; color:var(--muted); font-size:22rpx; }.plain-button::after { border:0; }.error-message { display:block; margin-top:18rpx; color:#c4382a; font-size:22rpx; text-align:center; }.resume { padding-top:130rpx; text-align:center; }.resume-duck { display:block; font-size:130rpx; }
.result-overlay { position:fixed; z-index:100; top:0; right:0; bottom:0; left:0; display:flex; align-items:center; justify-content:center; padding:44rpx; background:rgba(12,24,39,.62); }.result-dialog { box-sizing:border-box; width:100%; max-width:620rpx; padding:36rpx 38rpx 40rpx; border-radius:36rpx; background:var(--surface); color:var(--text); text-align:center; box-shadow:0 30rpx 80rpx rgba(9,28,48,.23); animation:result-appear .2s ease-out; }.result-icon { display:flex; align-items:center; justify-content:center; width:136rpx; height:136rpx; margin:0 auto 23rpx; border-radius:40rpx; background:var(--primary-soft); font-size:76rpx; }.result-kicker { display:block; color:var(--primary); font-size:23rpx; font-weight:700; }.result-text { display:block; margin-top:14rpx; font-size:39rpx; font-weight:800; line-height:1.35; }.result-note { display:block; margin-top:20rpx; color:var(--muted); font-size:22rpx; line-height:1.5; }.result-close { height:82rpx; line-height:82rpx; margin-top:30rpx; border-radius:22rpx; background:var(--primary); color:#fff; font-size:26rpx; font-weight:700; }.result-close::after { border:0; }@keyframes result-appear { from { opacity:0; transform:translateY(25rpx) scale(.96); } to { opacity:1; transform:translateY(0) scale(1); } }
