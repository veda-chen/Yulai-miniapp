.score-page { box-sizing:border-box; min-height:100vh; padding:28rpx 40rpx 70rpx; background:linear-gradient(180deg,var(--primary-soft),var(--page-bg) 430rpx); color:var(--text); }
.score-hero { padding:22rpx 7rpx 31rpx; }.score-kicker,.score-title,.score-rule { display:block; }.score-kicker { color:var(--primary); font-size:18rpx; font-weight:700; letter-spacing:3rpx; }.score-title { margin-top:10rpx; font-size:43rpx; font-weight:750; }.score-rule { margin-top:10rpx; color:var(--muted); font-size:23rpx; }
.status { margin-top:24rpx; padding:22rpx 25rpx; border-radius:22rpx; background:var(--surface); color:var(--muted); font-size:24rpx; font-weight:650; text-align:center; }.status.finished { background:#fff2d8; color:#946000; }.bottom-actions { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:16rpx; margin-top:24rpx; }.secondary-action { box-sizing:border-box; width:100%; min-width:0; height:76rpx; margin:0; padding:0 18rpx; border:1rpx solid var(--border); border-radius:999rpx; background:var(--surface); color:var(--text); font-size:24rpx; }.secondary-action.danger { border-color:#f0cbc7; color:#c3473e; }.secondary-action::after { border:0; }.privacy-note { display:block; margin-top:24rpx; color:var(--muted); font-size:20rpx; line-height:1.55; text-align:center; }
@media (max-width:360px) { .score-page { padding-right:24rpx; padding-left:24rpx; }.bottom-actions { grid-template-columns:1fr; } }
