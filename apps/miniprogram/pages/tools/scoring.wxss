.score-page { box-sizing:border-box; min-height:100vh; padding:28rpx 40rpx 70rpx; background:linear-gradient(180deg,#eaf8f4,#f6f7f9 430rpx); }.score-hero { padding:22rpx 7rpx 31rpx; }.score-kicker,.score-title,.score-rule { display:block; }.score-kicker { color:#11866f; font-size:18rpx; font-weight:700; letter-spacing:3rpx; }.score-title { margin-top:10rpx; font-size:43rpx; font-weight:750; }.score-rule { margin-top:10rpx; color:#65746f; font-size:23rpx; }.score-board { display:flex; align-items:stretch; padding:30rpx 24rpx; }.player { flex:1; min-width:0; display:flex; flex-direction:column; align-items:center; }.player input { box-sizing:border-box; width:100%; height:64rpx; border-bottom:1rpx solid #e0e5e3; font-size:25rpx; font-weight:650; text-align:center; }.score { margin:28rpx 0; font-size:94rpx; font-weight:780; line-height:1; }.score.blue { color:#147af3; }.score.green { color:#11866f; }.divider { display:flex; align-items:center; padding:0 20rpx; color:#a1aaa6; font-size:20rpx; }.score-actions { display:flex; gap:12rpx; }.score-actions button { box-sizing:border-box; width:72rpx; height:64rpx; margin:0; padding:0; border:0; border-radius:20rpx; background:#eef1f3; color:#53616a; font-size:27rpx; font-weight:700; }.score-actions .plus { width:100rpx; color:#fff; }.blue-bg { background:#147af3 !important; }.green-bg { background:#11866f !important; }.score-actions button::after,.secondary-action::after { border:0; }.status { margin-top:24rpx; padding:22rpx 25rpx; border-radius:22rpx; background:#fff; color:#53615d; font-size:24rpx; font-weight:650; text-align:center; }.status.finished { background:#fff2d8; color:#946000; }.bottom-actions { display:flex; gap:16rpx; margin-top:24rpx; }.secondary-action { flex:1; height:76rpx; margin:0; padding:0 18rpx; border:1rpx solid #ccd8d3; border-radius:999rpx; background:#fff; color:#476058; font-size:24rpx; }.secondary-action.danger { border-color:#f0cbc7; color:#c3473e; }.privacy-note { display:block; margin-top:24rpx; color:#8a9590; font-size:20rpx; line-height:1.55; text-align:center; }
