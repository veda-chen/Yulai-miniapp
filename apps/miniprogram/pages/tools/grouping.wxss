.tool-page { box-sizing:border-box; min-height:100vh; padding:28rpx 40rpx 70rpx; background:linear-gradient(180deg,#edf6ff,#f6f7f9 420rpx); }.intro { padding:16rpx 6rpx 28rpx; }.intro-title,.intro-copy { display:block; }.intro-title { font-size:42rpx; font-weight:750; }.intro-copy { margin-top:12rpx; color:#65747e; font-size:23rpx; line-height:1.55; }.form-card { padding:30rpx; }.label { display:block; margin-bottom:13rpx; font-size:25rpx; font-weight:650; }.form-card textarea { box-sizing:border-box; width:100%; height:230rpx; padding:20rpx; border:1rpx solid #dce4e9; border-radius:20rpx; background:#f8fafb; font-size:26rpx; line-height:1.5; }.count { display:block; margin-top:10rpx; color:#8a959d; font-size:20rpx; text-align:right; }.option-row { display:flex; align-items:center; justify-content:space-between; min-height:82rpx; margin-top:12rpx; border-top:1rpx solid #edf0f2; font-size:25rpx; }.picker-value { color:#147af3; font-weight:650; }.generate { height:84rpx; margin-top:18rpx; padding:0 28rpx; border:0; border-radius:999rpx; background:#147af3; color:#fff; font-size:27rpx; font-weight:700; }.generate::after { border:0; }.result-head { display:flex; justify-content:space-between; margin:34rpx 7rpx 17rpx; font-size:27rpx; font-weight:700; }.result-head text:last-child { color:#7e8991; font-size:21rpx; font-weight:500; }.match-card { margin-bottom:18rpx; padding:27rpx 30rpx; }.court { display:block; margin-bottom:18rpx; color:#147af3; font-size:21rpx; font-weight:700; }.side { display:flex; align-items:center; gap:18rpx; min-height:57rpx; font-size:27rpx; font-weight:650; }.side text:first-child { display:flex; align-items:center; justify-content:center; width:45rpx; height:45rpx; border-radius:15rpx; background:#e8f2ff; color:#147af3; font-size:21rpx; }.versus { margin:3rpx 0 3rpx 63rpx; color:#a0a8ad; font-size:18rpx; }.waiting { padding:26rpx 30rpx; }.waiting-title,.waiting-names { display:block; }.waiting-title { font-size:25rpx; font-weight:700; }.waiting-names { margin-top:10rpx; color:#66747d; font-size:23rpx; line-height:1.5; }
