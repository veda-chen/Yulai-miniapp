@import "./common.wxss";

.fair-page {
  padding-bottom: calc(80rpx + env(safe-area-inset-bottom));
}

.names-input {
  margin-top: 20rpx;
}

.player-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 18rpx;
  padding: 20rpx;
  border: 1rpx solid var(--border);
  border-radius: var(--control-radius);
  background: var(--page-bg);
  color: var(--muted);
  font-size: 21rpx;
}

.player-summary.ready {
  border-color: var(--primary);
  background: var(--primary-soft);
  color: var(--primary);
}

.summary-count {
  font-size: 40rpx;
  font-weight: 800;
}

.summary-unit {
  font-size: 22rpx;
}

.create-action {
  margin-top: 20rpx;
}

.create-action[disabled] {
  border-color: var(--border);
  background: var(--page-bg);
  color: var(--muted);
  box-shadow: none;
}

.saved-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding: 22rpx;
  border-radius: var(--control-radius);
  background: var(--primary-soft);
  color: var(--primary);
}

.saved-number {
  font-size: 42rpx;
  font-weight: 800;
}

.view-schedule,
.clear-action {
  box-sizing: border-box;
  width: 100%;
  height: 72rpx;
  margin: 16rpx 0 0;
  line-height: 72rpx;
}

.sheet-mask {
  position: fixed;
  z-index: 1000;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.56);
}

.schedule-sheet {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  width: 100%;
  height: 88vh;
  max-height: 88vh;
  padding: 30rpx 36rpx calc(24rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  border-radius: 38rpx 38rpx 0 0;
  background: var(--surface);
  box-shadow: 0 -18rpx 50rpx rgba(0, 0, 0, 0.18);
}

.sheet-header {
  display: flex;
  flex: none;
  align-items: flex-start;
  justify-content: space-between;
  padding: 0 4rpx 22rpx;
  border-bottom: 1rpx solid var(--border);
}

.sheet-title,
.sheet-copy {
  display: block;
}

.sheet-title {
  color: var(--text);
  font-size: 34rpx;
  font-weight: 800;
}

.sheet-copy {
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 21rpx;
}

.sheet-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin: -8rpx -8rpx 0 20rpx;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--muted);
  font-size: 54rpx;
  font-weight: 300;
  line-height: 64rpx;
}

.sheet-close::after {
  border: 0;
}

.schedule-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
}

.match-card {
  padding: 24rpx 10rpx 26rpx;
  border-bottom: 1rpx solid var(--border);
}

.match-number {
  display: block;
  color: var(--muted);
  font-size: 20rpx;
  text-align: center;
}

.match-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 80rpx minmax(0, 1fr);
  align-items: center;
  gap: 18rpx;
  margin-top: 14rpx;
}

.match-team {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 7rpx;
  min-width: 0;
}

.player-badge {
  box-sizing: border-box;
  width: 100%;
  max-width: 190rpx;
  min-height: 54rpx;
  padding: 8rpx 12rpx;
  overflow: hidden;
  border-radius: 10rpx;
  background: var(--primary);
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 650;
  line-height: 38rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.match-vs {
  color: var(--text);
  font-size: 38rpx;
  font-weight: 800;
  text-align: center;
}

.sheet-actions {
  display: grid;
  flex: none;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 16rpx;
  padding: 20rpx 0 6rpx;
  border-top: 1rpx solid var(--border);
}

.reroll-action,
.confirm-action {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  box-sizing: border-box;
  min-width: 0;
  width: 100%;
  height: 82rpx;
  margin: 0;
  padding: 0 10rpx;
  overflow: visible;
  line-height: 1.2;
  white-space: nowrap;
}

.action-icon {
  flex: none;
  font-size: 29rpx;
  line-height: 1;
}

@media (max-width: 360px) {
  .player-summary {
    align-items: flex-start;
    flex-direction: column;
  }

  .schedule-sheet {
    padding-right: 24rpx;
    padding-left: 24rpx;
  }

  .match-layout {
    grid-template-columns: minmax(0, 1fr) 58rpx minmax(0, 1fr);
    gap: 10rpx;
  }

  .sheet-actions {
    gap: 10rpx;
  }

  .reroll-action,
  .confirm-action {
    gap: 7rpx;
    padding: 0 6rpx;
    font-size: 21rpx;
  }

  .player-badge {
    font-size: 20rpx;
  }
}
