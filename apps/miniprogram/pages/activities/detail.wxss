.detail-page { box-sizing:border-box; min-height:100vh; padding:22rpx 32rpx 40rpx; background:var(--page-bg); }.state-card { padding:60rpx 30rpx; color:var(--muted); text-align:center; }.state-title,.state-copy { display:block; }.state-title { color:var(--text); font-size:31rpx; font-weight:700; }.state-copy { margin-top:14rpx; font-size:23rpx; line-height:1.55; }.state-action { width:280rpx; margin:28rpx auto 0; }.state-home { margin:14rpx auto 0; border:0; background:transparent; color:var(--primary); font-size:23rpx; }.state-home::after { border:0; }
.headline { padding:18rpx 8rpx 36rpx; }.headline-top,.section-head,.roster-card { display:flex; align-items:center; justify-content:space-between; }.level-pill,.tag { display:inline-block; padding:8rpx 18rpx; border-radius:999rpx; background:var(--primary-soft); color:#0064d6; font-size:22rpx; font-weight:650; }.share { display:flex; flex:0 0 112rpx; align-items:center; justify-content:center; box-sizing:border-box; width:112rpx; min-width:112rpx; max-width:112rpx; height:56rpx; margin:0 0 0 auto; padding:0; border:0; border-radius:999rpx; background:var(--surface); color:var(--primary); font-size:22rpx; line-height:1; }.share::after { border:0; }.title { display:block; margin-top:24rpx; font-size:47rpx; font-weight:750; line-height:1.26; letter-spacing:-1rpx; }.organizer { display:flex; align-items:center; gap:12rpx; margin-top:24rpx; color:var(--muted); font-size:24rpx; }.avatar,.member-avatar { display:flex; align-items:center; justify-content:center; border-radius:50%; background:linear-gradient(135deg,#cfe5ff,#66abff); color:#fff; font-weight:700; }.avatar { width:48rpx; height:48rpx; font-size:21rpx; }
.notice { margin-bottom:20rpx; padding:22rpx 26rpx; border-radius:24rpx; font-size:25rpx; }.notice.success { background:#e9f9ee; color:#18823a; }.notice.danger { background:#ffecea; color:#c5271f; }.notice.muted { background:#e5e5ea; color:var(--muted); }.change-alert { margin-bottom:22rpx; padding:28rpx; background:#fff8e6; }.compact { height:76rpx; margin-top:20rpx; line-height:76rpx; font-size:25rpx; }
.info-card { padding:4rpx 30rpx; }.info-row { display:flex; align-items:center; min-height:122rpx; border-bottom:1rpx solid var(--border); }.info-row:last-child { border-bottom:0; }.info-icon { display:flex; flex:none; align-items:center; justify-content:center; width:64rpx; height:64rpx; margin-right:22rpx; border-radius:20rpx; font-size:23rpx; font-weight:700; }.blue { background:var(--primary-soft); color:var(--primary); }.green { background:#e9f9ee; color:#34a853; }.orange { background:#fff3d1; color:#bf7800; }.purple { background:#f2eefe; color:#5856d6; }.info-title,.secondary { display:block; }.info-title { color:var(--text); font-size:27rpx; font-weight:600; }.secondary { margin-top:5rpx; color:var(--muted); font-size:22rpx; }.grow { flex:1; }.link,.manage-link { color:var(--primary); font-size:24rpx; font-weight:600; }.unavailable { color:#c65b22; font-size:22rpx; }.disabled { opacity:.5; pointer-events:none; }
.section { margin-top:30rpx; }.live-entry { display:flex; align-items:center; justify-content:space-between; margin-top:30rpx; padding:30rpx; border-radius:36rpx; background:linear-gradient(135deg,var(--primary),#0064d6); color:#fff; box-shadow:0 12rpx 30rpx rgba(0,122,255,.22); }.live-title { display:block; font-size:31rpx; font-weight:700; }.live-entry .secondary { color:rgba(255,255,255,.78); }.section-title { font-size:31rpx; font-weight:700; }.roster-card { min-height:92rpx; margin-top:18rpx; padding:20rpx 26rpx; }.avatar-list { display:flex; }.member-avatar { width:56rpx; height:56rpx; margin-right:-10rpx; border:4rpx solid #fff; font-size:21rpx; }.content-card { padding:30rpx; }.tag-row { display:flex; flex-wrap:wrap; gap:12rpx; margin-top:22rpx; }.tag { background:var(--page-bg); color:#48484a; }.body-copy { display:block; margin-top:22rpx; color:#48484a; font-size:25rpx; line-height:1.65; }.change-row { display:flex; justify-content:space-between; margin-top:20rpx; font-size:24rpx; }
.organizer-actions { display:flex; flex-direction:column; gap:16rpx; margin-top:30rpx; padding:30rpx; }.outline { display:flex; align-items:center; justify-content:center; box-sizing:border-box; width:100%; height:80rpx; min-height:80rpx; margin:0; padding:0; border:1rpx solid var(--primary); border-radius:999rpx; background:var(--surface); color:var(--primary); font-size:26rpx; line-height:1; text-align:center; }.outline::after { border:0; }.outline.destructive { border-color:#ff3b30; color:#ff3b30; }.report-link { margin:32rpx 0; color:var(--muted); font-size:23rpx; text-align:center; }.action-spacer { height:110rpx; }
.action-bar { position:fixed; z-index:20; right:0; bottom:0; left:0; display:flex; align-items:center; justify-content:space-between; min-height:112rpx; padding:18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom)); border-top:1rpx solid var(--border); background:rgba(255,255,255,.97); }.action-state { color:#48484a; font-size:24rpx; }.success-text { color:#18823a; }.wait-text { color:#9a6c00; }.join-action,.leave-action { display:flex; align-items:center; justify-content:center; box-sizing:border-box; width:250rpx; height:84rpx; margin:0; padding:0; line-height:1; }.leave-action { border:1rpx solid #ff3b30; border-radius:999rpx; background:var(--surface); color:#ff3b30; font-size:27rpx; }.leave-action::after { border:0; }.closed { color:var(--muted); font-size:24rpx; }
.compact { box-sizing:border-box; padding:0 24rpx; }
.level-pill { color:var(--primary); }.tag,.body-copy,.action-state { color:var(--text); }
.operation-status { display:flex; align-items:center; justify-content:space-between; gap:18rpx; margin-bottom:20rpx; padding:20rpx 24rpx; border-radius:var(--control-radius); background:var(--primary-soft); color:var(--primary); font-size:23rpx; line-height:1.45; }.operation-status.success { background:#e9f9ee; color:#18823a; }.operation-status.warning { background:#fff3d1; color:#815a00; }.operation-status.error { background:#ffecea; color:#c5271f; }.operation-status button { flex:none; min-width:126rpx; min-height:64rpx; margin:0; padding:0 16rpx; border:0; border-radius:999rpx; background:var(--surface); color:currentColor; font-size:21rpx; }.operation-status button::after { border:0; }
.organizer-actions { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); }.organizer-title,.cancel-action { grid-column:1 / -1; }.action-bar { box-sizing:border-box; background:var(--surface); }.action-spacer { height:calc(150rpx + env(safe-area-inset-bottom)); }
@media (max-width:360px) { .organizer-actions { grid-template-columns:1fr; }.organizer-title,.cancel-action { grid-column:auto; }.action-bar { gap:18rpx; flex-wrap:wrap; }.join-action,.leave-action { width:100%; }.action-bar > view { width:100%; } }
.roster-card { display:block; } .roster-list { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:14rpx; width:100%; } .roster-member { display:flex; align-items:center; min-width:0; padding:12rpx; border-radius:var(--control-radius); background:var(--page-bg); } .roster-member .member-avatar { flex:none; width:56rpx; height:56rpx; margin:0 13rpx 0 0; border:0; font-size:21rpx; } .member-copy { min-width:0; } .member-name,.member-status { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; } .member-name { color:var(--text); font-size:23rpx; font-weight:650; } .member-status { margin-top:3rpx; color:var(--muted); font-size:19rpx; } .roster-card .manage-link { display:block; margin-top:18rpx; text-align:right; }
@media (max-width:360px) { .roster-list { grid-template-columns:1fr; } }
@media (max-width:360px) { .detail-page { padding-right:24rpx; padding-left:24rpx; }.operation-status { align-items:stretch; flex-direction:column; }.operation-status button { width:100%; }.state-action { width:100%; }.headline-top { gap:12rpx; }.share { flex-basis:104rpx; width:104rpx; min-width:104rpx; max-width:104rpx; } }
