.detail-page { box-sizing:border-box; min-height:100vh; padding:22rpx 32rpx 40rpx; background:#f2f2f7; }.state-card { padding:60rpx 30rpx; color:#6e6e73; text-align:center; }
.headline { padding:18rpx 8rpx 36rpx; }.headline-top,.section-head,.roster-card { display:flex; align-items:center; justify-content:space-between; }.level-pill,.tag { display:inline-block; padding:8rpx 18rpx; border-radius:999rpx; background:#e8f2ff; color:#0064d6; font-size:22rpx; font-weight:650; }.share { display:flex; flex:0 0 112rpx; align-items:center; justify-content:center; box-sizing:border-box; width:112rpx; min-width:112rpx; max-width:112rpx; height:56rpx; margin:0 0 0 auto; padding:0; border:0; border-radius:999rpx; background:#fff; color:#007aff; font-size:22rpx; line-height:1; }.share::after { border:0; }.title { display:block; margin-top:24rpx; font-size:47rpx; font-weight:750; line-height:1.26; letter-spacing:-1rpx; }.organizer { display:flex; align-items:center; gap:12rpx; margin-top:24rpx; color:#6e6e73; font-size:24rpx; }.avatar,.member-avatar { display:flex; align-items:center; justify-content:center; border-radius:50%; background:linear-gradient(135deg,#cfe5ff,#66abff); color:#fff; font-weight:700; }.avatar { width:48rpx; height:48rpx; font-size:21rpx; }
.notice { margin-bottom:20rpx; padding:22rpx 26rpx; border-radius:24rpx; font-size:25rpx; }.notice.success { background:#e9f9ee; color:#18823a; }.notice.danger { background:#ffecea; color:#c5271f; }.notice.muted { background:#e5e5ea; color:#6e6e73; }.change-alert { margin-bottom:22rpx; padding:28rpx; background:#fff8e6; }.compact { height:76rpx; margin-top:20rpx; line-height:76rpx; font-size:25rpx; }
.info-card { padding:4rpx 30rpx; }.info-row { display:flex; align-items:center; min-height:122rpx; border-bottom:1rpx solid #e5e5ea; }.info-row:last-child { border-bottom:0; }.info-icon { display:flex; flex:none; align-items:center; justify-content:center; width:64rpx; height:64rpx; margin-right:22rpx; border-radius:20rpx; font-size:23rpx; font-weight:700; }.blue { background:#e8f2ff; color:#007aff; }.green { background:#e9f9ee; color:#34a853; }.orange { background:#fff3d1; color:#bf7800; }.purple { background:#f2eefe; color:#5856d6; }.info-title,.secondary { display:block; }.info-title { color:#1d1d1f; font-size:27rpx; font-weight:600; }.secondary { margin-top:5rpx; color:#8e8e93; font-size:22rpx; }.grow { flex:1; }.link,.manage-link { color:#007aff; font-size:24rpx; font-weight:600; }
.section { margin-top:30rpx; }.live-entry { display:flex; align-items:center; justify-content:space-between; margin-top:30rpx; padding:30rpx; border-radius:36rpx; background:linear-gradient(135deg,#007aff,#0064d6); color:#fff; box-shadow:0 12rpx 30rpx rgba(0,122,255,.22); }.live-title { display:block; font-size:31rpx; font-weight:700; }.live-entry .secondary { color:rgba(255,255,255,.78); }.section-title { font-size:31rpx; font-weight:700; }.roster-card { min-height:92rpx; margin-top:18rpx; padding:20rpx 26rpx; }.avatar-list { display:flex; }.member-avatar { width:56rpx; height:56rpx; margin-right:-10rpx; border:4rpx solid #fff; font-size:21rpx; }.content-card { padding:30rpx; }.tag-row { display:flex; flex-wrap:wrap; gap:12rpx; margin-top:22rpx; }.tag { background:#f2f2f7; color:#48484a; }.body-copy { display:block; margin-top:22rpx; color:#48484a; font-size:25rpx; line-height:1.65; }.change-row { display:flex; justify-content:space-between; margin-top:20rpx; font-size:24rpx; }
.organizer-actions { display:flex; flex-direction:column; gap:16rpx; margin-top:30rpx; padding:30rpx; }.outline { display:flex; align-items:center; justify-content:center; box-sizing:border-box; width:100%; height:80rpx; min-height:80rpx; margin:0; padding:0; border:1rpx solid #007aff; border-radius:999rpx; background:#fff; color:#007aff; font-size:26rpx; line-height:1; text-align:center; }.outline::after { border:0; }.outline.destructive { border-color:#ff3b30; color:#ff3b30; }.report-link { margin:32rpx 0; color:#8e8e93; font-size:23rpx; text-align:center; }.action-spacer { height:110rpx; }
.action-bar { position:fixed; z-index:20; right:0; bottom:0; left:0; display:flex; align-items:center; justify-content:space-between; min-height:112rpx; padding:18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom)); border-top:1rpx solid #e5e5ea; background:rgba(255,255,255,.97); }.action-state { color:#48484a; font-size:24rpx; }.success-text { color:#18823a; }.wait-text { color:#9a6c00; }.join-action,.leave-action { display:flex; align-items:center; justify-content:center; box-sizing:border-box; width:250rpx; height:84rpx; margin:0; padding:0; line-height:1; }.leave-action { border:1rpx solid #ff3b30; border-radius:999rpx; background:#fff; color:#ff3b30; font-size:27rpx; }.leave-action::after { border:0; }.closed { color:#8e8e93; font-size:24rpx; }
