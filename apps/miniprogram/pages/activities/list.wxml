<view class="list-page {{appearanceClass}}">
  <view class="list-banner">
    <image class="banner-image" src="/assets/activity-header-v2.jpg" mode="aspectFill" />
    <view class="banner-shade"></view>
    <view class="banner-content"><text class="banner-kicker">YULAI · 羽来</text><text class="page-title">找到今晚的球局</text><text class="banner-copy">和附近球友，一起上场</text></view>
    <navigator class="create-round" url="/pages/activities/form">＋</navigator>
  </view>
  <view class="search-wrap"><view class="search-icon"></view><input value="{{keyword}}" maxlength="50" confirm-type="search" placeholder="搜索球局、场馆、学校" bindinput="onSearchInput" bindconfirm="confirmSearch" /></view>
  <scroll-view class="chips" scroll-x show-scrollbar="{{false}}"><view class="chip-track"><text wx:for="{{filters}}" wx:key="key" class="chip {{activeFilter === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="onFilterTap">{{item.label}}</text></view></scroll-view>
  <view wx:if="{{loading && activities.length === 0}}" class="empty surface">正在加载球局</view>
  <view wx:elif="{{message && activities.length === 0}}" class="empty surface"><text>{{message}}</text><button class="retry-button" bindtap="retry">重新加载</button></view>
  <view wx:elif="{{viewActivities.length === 0 && nextOffset !== null}}" class="empty surface"><text>当前批次暂无匹配，可继续查看</text><button class="retry-button" bindtap="onReachBottom">继续查看</button></view>
  <view wx:elif="{{viewActivities.length === 0}}" class="empty surface">没有找到符合条件的公开球局</view>
  <view wx:else class="activity-list">
    <navigator wx:for="{{viewActivities}}" wx:key="id" class="activity-row surface" url="/pages/activities/detail?id={{item.id}}">
      <view class="time-col"><text class="day">{{item.shortDay}}</text><text class="clock">{{item.shortClock}}</text></view>
      <view class="info-col"><text class="row-title">{{item.title}}</text><text class="venue">⌖ {{item.venue.name}}</text>
        <view class="row-footer"><view><status-chip label="{{item.levelText}}" tone="primary" /><status-chip wx:if="{{item.registrationText}}" label="{{item.registrationText}}" tone="success" /></view><text class="count">{{item.registeredCount}}/{{item.capacity}} 人 ›</text></view>
      </view>
    </navigator>
  </view>
  <view wx:if="{{message && activities.length}}" class="load-message">{{message}}</view>
  <button wx:if="{{nextOffset !== null}}" class="load-more" loading="{{loadingMore}}" bindtap="onReachBottom">{{loadingMore ? '正在加载' : '加载更多球局'}}</button>
</view>
