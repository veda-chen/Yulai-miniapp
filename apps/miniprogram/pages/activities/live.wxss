.live-page { box-sizing:border-box; min-height:100vh; padding:24rpx 32rpx 70rpx; background:#f2f2f7; }.hero { padding:38rpx; border-radius:38rpx; background:linear-gradient(135deg,#007aff,#004fad); color:#fff; box-shadow:0 12rpx 34rpx rgba(0,122,255,.22); }.hero-title,.hero-copy { display:block; }.hero-title { font-size:42rpx; font-weight:750; }.hero-copy { margin-top:10rpx; font-size:24rpx; opacity:.8; }.feature-row { display:flex; gap:14rpx; margin-top:24rpx; }.feature-row text { padding:8rpx 16rpx; border-radius:999rpx; background:rgba(255,255,255,.18); font-size:21rpx; }
.section-head { display:flex; align-items:center; justify-content:space-between; margin:36rpx 8rpx 18rpx; }.section-title { display:block; font-size:31rpx; font-weight:700; }.secondary { display:block; margin-top:6rpx; color:#8e8e93; font-size:22rpx; }.people { display:flex; flex-wrap:wrap; gap:24rpx; padding:28rpx; }.person { display:flex; flex-direction:column; align-items:center; width:120rpx; font-size:22rpx; }.person-avatar { display:flex; align-items:center; justify-content:center; overflow:hidden; width:70rpx; height:70rpx; border-radius:50%; background:#e8f2ff; color:#007aff; font-size:20rpx; font-weight:700; }.attendance { margin-top:7rpx; color:#8e8e93; font-size:19rpx; }.attendance.checked { color:#34a853; }
.tool,.manual { margin-top:28rpx; padding:30rpx; }.picker { margin-top:24rpx; padding:20rpx 24rpx; border-radius:22rpx; background:#f2f2f7; color:#007aff; font-size:25rpx; }.tool-button { height:84rpx; margin-top:20rpx; line-height:84rpx; }.round { display:flex; align-items:center; justify-content:space-between; margin-bottom:16rpx; padding:24rpx 28rpx; }.round-title { display:block; font-size:28rpx; font-weight:700; }.publish { width:auto; margin:0; padding:12rpx 24rpx; border:0; border-radius:999rpx; background:#007aff; color:#fff; font-size:23rpx; line-height:1.5; }.publish::after { border:0; }
.select-players { display:flex; flex-wrap:wrap; gap:16rpx; margin-top:24rpx; }.check-person { padding:13rpx 18rpx; border-radius:20rpx; background:#f2f2f7; font-size:23rpx; }.outline-button { margin-top:24rpx; border:1rpx solid #007aff; border-radius:999rpx; background:#fff; color:#007aff; font-size:26rpx; }.outline-button::after { border:0; }
.match-type-picker { display:flex; align-items:center; justify-content:space-between; margin-top:22rpx; padding:20rpx 22rpx; border-radius:18rpx; background:#f2f2f7; color:#48484a; font-size:24rpx; }.match-type-picker text:last-child { color:#007aff; font-weight:650; }.selection-count { display:block; margin-top:18rpx; color:#6e6e73; font-size:21rpx; }
.match { margin-bottom:20rpx; padding:28rpx; }.match-head { display:flex; justify-content:space-between; padding-bottom:20rpx; border-bottom:1rpx solid #e5e5ea; }.court { font-size:27rpx; font-weight:700; }.status { padding:6rpx 14rpx; border-radius:999rpx; background:#e8f2ff; color:#0064d6; font-size:20rpx; }.team-row { display:flex; align-items:center; justify-content:space-between; min-height:82rpx; border-bottom:1rpx solid #f2f2f7; }.team { flex:1; font-size:26rpx; }.team-row input { box-sizing:border-box; width:96rpx; height:58rpx; border-radius:16rpx; background:#f2f2f7; font-size:30rpx; font-weight:750; text-align:center; }.versus { color:#8e8e93; font-size:22rpx; }.match-actions { display:flex; flex-wrap:wrap; gap:12rpx; margin-top:22rpx; }.small { width:auto; margin:0; padding:10rpx 20rpx; border:1rpx solid #d1d1d6; border-radius:999rpx; background:#fff; color:#48484a; font-size:22rpx; line-height:1.5; }.small::after { border:0; }.small.primary { border-color:#007aff; background:#007aff; color:#fff; }.small.danger { border-color:#ff3b30; color:#ff3b30; }.confirm-text { margin-top:16rpx; }.empty { padding:50rpx 28rpx; color:#8e8e93; font-size:25rpx; text-align:center; }
.adjust-button { margin-top:20rpx; border:1rpx solid #007aff; border-radius:999rpx; background:#fff; color:#007aff; font-size:23rpx; }.adjust-button::after { border:0; }
.match-type-label { margin-left:12rpx; padding:5rpx 10rpx; border-radius:999rpx; background:#f2f2f7; color:#6e6e73; font-size:18rpx; font-weight:600; }
