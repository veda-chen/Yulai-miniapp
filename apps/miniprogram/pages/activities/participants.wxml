<view class="page {{appearanceClass}}">
  <empty-state wx:if="{{loading && participants.length === 0}}" title="正在加载成员" description="请稍候" />
  <empty-state wx:elif="{{message && participants.length === 0}}" title="暂时无法加载成员" description="{{message}}" action-text="重新加载" bind:action="retry" />
  <view wx:if="{{message && participants.length > 0}}" class="inline-message"><text>{{message}}</text><button bindtap="retry">重试</button></view>
  <empty-state wx:elif="{{!loading && participants.length === 0}}" title="暂无正式成员" description="报名成功的球友会显示在这里" />
  <view wx:for="{{participants}}" wx:key="userId" class="member" data-user-id="{{item.userId}}" bindtap="changeAttendance">
    <text>{{item.nickname}}</text><text class="status">{{item.statusText}}</text>
  </view>
  <text wx:if="{{canManage}}" class="tip">点击成员可修改到场状态</text>
  <view wx:if="{{waitlist.length > 0}}" class="section-title">候补名单</view>
  <view wx:for="{{waitlist}}" wx:key="userId" class="member">
    <text>第{{item.position}}位 · {{item.nickname}}</text>
    <button wx:if="{{canManage}}" class="promote-button" data-user-id="{{item.userId}}" loading="{{submittingUserId === item.userId}}" disabled="{{submittingUserId !== ''}}" bindtap="promote">补入</button>
  </view>
</view>
