.list-page { min-height:100vh; box-sizing:border-box; padding:24rpx 40rpx 60rpx; background:linear-gradient(180deg,#eef6ff 0,#f7f7fa 420rpx); }
.list-banner { position:relative; overflow:hidden; height:300rpx; border-radius:36rpx; background:#195d83; box-shadow:0 16rpx 38rpx rgba(18,63,102,.18); }.banner-image,.banner-shade { position:absolute; inset:0; width:100%; height:100%; }.banner-shade { background:linear-gradient(90deg,rgba(5,30,51,.78) 0,rgba(5,30,51,.38) 58%,rgba(5,30,51,.12) 100%); }.banner-content { position:relative; z-index:1; display:flex; flex-direction:column; justify-content:center; box-sizing:border-box; height:100%; padding:42rpx; color:#fff; }.banner-kicker { font-size:19rpx; font-weight:700; letter-spacing:3rpx; opacity:.72; }.page-title { margin-top:16rpx; font-size:42rpx; font-weight:750; letter-spacing:-1rpx; }.banner-copy { margin-top:14rpx; font-size:25rpx; opacity:.88; }.create-round { position:absolute; right:28rpx; bottom:28rpx; z-index:2; display:flex; align-items:center; justify-content:center; width:76rpx; height:76rpx; border:2rpx solid rgba(255,255,255,.55); border-radius:50%; background:rgba(255,255,255,.94); color:#007aff; font-size:42rpx; box-shadow:0 8rpx 22rpx rgba(0,0,0,.2); }
.search-wrap { position:relative; z-index:3; display:flex; align-items:center; box-sizing:border-box; height:88rpx; margin:-22rpx 22rpx 0; padding:0 28rpx; border-radius:28rpx; background:#fff; box-shadow:0 12rpx 32rpx rgba(27,72,120,.13); }.search-icon { width:22rpx; height:22rpx; margin-right:20rpx; border:4rpx solid #8e8e93; border-radius:50%; }.search-icon::after { content:""; display:block; width:13rpx; height:4rpx; margin:18rpx 0 0 17rpx; border-radius:4rpx; background:#8e8e93; transform:rotate(45deg); }.search-wrap input { flex:1; height:84rpx; font-size:27rpx; }
.chips { width:100%; margin:26rpx 0 30rpx; }.chip-track { display:flex; gap:14rpx; }.chip { flex:none; padding:13rpx 25rpx; border-radius:999rpx; background:#fff; border:1rpx solid #e5e5ea; color:#6e6e73; font-size:23rpx; box-shadow:0 3rpx 8rpx rgba(0,0,0,.025); }.chip.active { border-color:#007aff; background:#007aff; color:#fff; }
.activity-list { display:flex; flex-direction:column; gap:20rpx; }.activity-row { display:flex; padding:28rpx; box-shadow:0 10rpx 28rpx rgba(30,55,84,.06); }.time-col { flex:none; display:flex; flex-direction:column; align-items:center; justify-content:center; width:112rpx; min-height:150rpx; margin-right:28rpx; border-right:1rpx solid #e5e5ea; }.day { color:#007aff; font-size:23rpx; font-weight:650; }.clock { margin-top:8rpx; font-size:29rpx; font-weight:750; }
.info-col { flex:1; min-width:0; }.row-title,.venue { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }.row-title { font-size:29rpx; font-weight:700; }.venue { margin-top:13rpx; color:#6e6e73; font-size:24rpx; }.row-footer { display:flex; align-items:center; justify-content:space-between; margin-top:22rpx; }.badge,.mine { display:inline-block; margin-right:10rpx; padding:7rpx 15rpx; border-radius:999rpx; background:#e8f2ff; color:#0064d6; font-size:20rpx; font-weight:600; }.mine { background:#e9f9ee; color:#18823a; }.count { color:#6e6e73; font-size:23rpx; }
.empty { padding:60rpx 30rpx; color:#6e6e73; font-size:26rpx; text-align:center; }
