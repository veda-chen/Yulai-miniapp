.list-page { min-height:100vh; box-sizing:border-box; padding:24rpx 40rpx 60rpx; background:linear-gradient(180deg,#eef6ff 0,#f7f7fa 420rpx); }
.list-banner { position:relative; overflow:hidden; height:300rpx; border-radius:36rpx; background:#195d83; box-shadow:0 16rpx 38rpx rgba(18,63,102,.18); }.banner-image,.banner-shade { position:absolute; inset:0; width:100%; height:100%; }.banner-shade { background:linear-gradient(90deg,rgba(5,30,51,.78) 0,rgba(5,30,51,.38) 58%,rgba(5,30,51,.12) 100%); }.banner-content { position:relative; z-index:1; display:flex; flex-direction:column; justify-content:center; box-sizing:border-box; height:100%; padding:42rpx; color:#fff; }.banner-kicker { font-size:19rpx; font-weight:700; letter-spacing:3rpx; opacity:.72; }.page-title { margin-top:16rpx; font-size:42rpx; font-weight:750; letter-spacing:-1rpx; }.banner-copy { margin-top:14rpx; font-size:25rpx; opacity:.88; }.create-round { position:absolute; right:28rpx; bottom:28rpx; z-index:2; display:flex; align-items:center; justify-content:center; width:76rpx; height:76rpx; border:2rpx solid rgba(255,255,255,.55); border-radius:50%; background:rgba(255,255,255,.94); color:var(--primary); font-size:42rpx; box-shadow:0 8rpx 22rpx rgba(0,0,0,.2); }
.search-wrap { position:relative; z-index:3; display:flex; align-items:center; box-sizing:border-box; height:88rpx; margin:-22rpx 22rpx 0; padding:0 28rpx; border-radius:28rpx; background:var(--surface); box-shadow:0 12rpx 32rpx rgba(27,72,120,.13); }.search-icon { width:22rpx; height:22rpx; margin-right:20rpx; border:4rpx solid #8e8e93; border-radius:50%; }.search-icon::after { content:""; display:block; width:13rpx; height:4rpx; margin:18rpx 0 0 17rpx; border-radius:4rpx; background:#8e8e93; transform:rotate(45deg); }.search-wrap input { flex:1; height:84rpx; font-size:27rpx; }
.search-clear { display:flex; flex:none; align-items:center; justify-content:center; width:64rpx; height:64rpx; margin:0 -14rpx 0 10rpx; padding:0; border:0; border-radius:50%; background:transparent; color:var(--muted); font-size:34rpx; }.search-clear::after { border:0; }
.chips { width:100%; margin:26rpx 0 30rpx; }.chip-track { display:flex; gap:14rpx; }.chip { flex:none; padding:13rpx 25rpx; border-radius:999rpx; background:var(--surface); border:1rpx solid var(--border); color:var(--muted); font-size:23rpx; box-shadow:0 3rpx 8rpx rgba(0,0,0,.025); }.chip.active { border-color:var(--primary); background:var(--primary); color:#fff; }
.filter-panel { margin:24rpx 0; padding:24rpx; border:1rpx solid var(--border); border-radius:var(--surface-radius,24rpx); }
.filter-label { margin-bottom:16rpx; color:var(--muted); font-size:22rpx; }
.filter-panel .chip-track { flex-wrap:wrap; }
.filter-controls { display:flex; gap:14rpx; margin-top:22rpx; }
.filter-controls picker { flex:1; min-width:0; }
.filter-picker { overflow:hidden; height:72rpx; padding:0 16rpx; border:1rpx solid var(--border); border-radius:var(--control-radius); color:var(--text); line-height:72rpx; text-overflow:ellipsis; white-space:nowrap; font-size:22rpx; }
.spots-row { display:flex; align-items:center; justify-content:space-between; min-height:80rpx; margin-top:12rpx; color:var(--text); font-size:24rpx; }
.spots-row switch { transform:scale(.8); transform-origin:right center; }
.result-summary { display:flex; align-items:center; justify-content:space-between; gap:18rpx; margin:-8rpx 4rpx 22rpx; color:var(--muted); font-size:21rpx; line-height:1.45; }.result-summary text { flex:1; min-width:0; }.result-summary button { flex:none; min-width:96rpx; height:64rpx; margin:0; padding:0 16rpx; border:0; border-radius:999rpx; background:var(--primary-soft); color:var(--primary); font-size:20rpx; }.result-summary button::after { border:0; }
.activity-list { display:flex; flex-direction:column; gap:20rpx; }.activity-row { display:flex; padding:28rpx; box-shadow:0 10rpx 28rpx rgba(30,55,84,.06); }.time-col { flex:none; display:flex; flex-direction:column; align-items:center; justify-content:center; width:112rpx; min-height:150rpx; margin-right:28rpx; border-right:1rpx solid var(--border); }.day { color:var(--primary); font-size:23rpx; font-weight:650; }.clock { margin-top:8rpx; font-size:29rpx; font-weight:750; }
.info-col { flex:1; min-width:0; }.row-title,.venue { display:-webkit-box; overflow:hidden; line-height:1.4; -webkit-box-orient:vertical; -webkit-line-clamp:2; }.row-title { font-size:29rpx; font-weight:700; }.venue { margin-top:13rpx; color:var(--muted); font-size:24rpx; }.row-footer { display:flex; align-items:center; justify-content:space-between; gap:14rpx; flex-wrap:wrap; margin-top:22rpx; }.row-footer status-chip + status-chip { margin-left:10rpx; }.count { color:var(--muted); font-size:23rpx; }
.organizer-row { display:flex; align-items:center; min-width:0; margin-top:12rpx; color:var(--muted); font-size:21rpx; }.organizer-row text { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }.organizer-mark { flex:none; display:flex; align-items:center; justify-content:center; width:30rpx; height:30rpx; margin-right:9rpx; border-radius:50%; background:var(--primary-soft); color:var(--primary); font-size:16rpx; font-weight:750; }
.empty { padding:60rpx 30rpx; color:var(--muted); font-size:26rpx; text-align:center; }
.load-more { width:100%; height:72rpx; margin:20rpx 0; border:1rpx solid var(--border); border-radius:var(--control-radius); background:var(--surface); color:var(--primary); font-size:22rpx; }.load-more::after { border:0; }
.retry-button { width:220rpx; height:64rpx; margin:20rpx auto 0; border:0; border-radius:999rpx; background:var(--primary); color:#fff; font-size:22rpx; }.retry-button::after { border:0; }.load-message { margin-top:18rpx; padding:18rpx; border-radius:18rpx; background:var(--primary-soft); color:var(--primary); font-size:21rpx; text-align:center; }
@media (max-width:360px) { .list-page { padding-right:24rpx; padding-left:24rpx; }.activity-row { padding:22rpx; }.time-col { width:92rpx; margin-right:20rpx; }.row-footer { align-items:flex-start; flex-direction:column; } }
