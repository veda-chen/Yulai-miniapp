.list-page { min-height:100vh; box-sizing:border-box; padding:24rpx 40rpx 60rpx; background:#f7f7fa; }
.title-row { display:flex; align-items:center; justify-content:space-between; }.page-title { font-size:58rpx; font-weight:750; letter-spacing:-2rpx; }.create-round { display:flex; align-items:center; justify-content:center; width:72rpx; height:72rpx; border-radius:50%; background:#007aff; color:#fff; font-size:42rpx; box-shadow:0 8rpx 20rpx rgba(0,122,255,.22); }
.search-wrap { display:flex; align-items:center; box-sizing:border-box; height:84rpx; margin-top:30rpx; padding:0 26rpx; border-radius:26rpx; background:#fff; border:1rpx solid #e5e5ea; }.search-icon { margin-right:14rpx; color:#8e8e93; font-size:34rpx; }.search-wrap input { flex:1; height:84rpx; font-size:27rpx; }
.chips { width:100%; margin:22rpx 0 30rpx; }.chip-track { display:flex; gap:14rpx; }.chip { flex:none; padding:13rpx 25rpx; border-radius:999rpx; background:#fff; border:1rpx solid #e5e5ea; color:#6e6e73; font-size:23rpx; }.chip.active { border-color:#007aff; background:#007aff; color:#fff; }
.activity-list { display:flex; flex-direction:column; gap:20rpx; }.activity-row { display:flex; padding:28rpx; }.time-col { flex:none; display:flex; flex-direction:column; align-items:center; justify-content:center; width:112rpx; min-height:150rpx; margin-right:28rpx; border-right:1rpx solid #e5e5ea; }.day { color:#007aff; font-size:23rpx; font-weight:650; }.clock { margin-top:8rpx; font-size:29rpx; font-weight:750; }
.info-col { flex:1; min-width:0; }.row-title,.venue { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }.row-title { font-size:29rpx; font-weight:700; }.venue { margin-top:13rpx; color:#6e6e73; font-size:24rpx; }.row-footer { display:flex; align-items:center; justify-content:space-between; margin-top:22rpx; }.badge,.mine { display:inline-block; margin-right:10rpx; padding:7rpx 15rpx; border-radius:999rpx; background:#e8f2ff; color:#0064d6; font-size:20rpx; font-weight:600; }.mine { background:#e9f9ee; color:#18823a; }.count { color:#6e6e73; font-size:23rpx; }
.empty { padding:60rpx 30rpx; color:#6e6e73; font-size:26rpx; text-align:center; }
