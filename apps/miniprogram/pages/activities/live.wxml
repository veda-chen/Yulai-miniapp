<view class="live-page">
  <view wx:if="{{loading}}" class="empty surface">正在加载现场</view><view wx:elif="{{message}}" class="empty surface">{{message}}</view>
  <block wx:else>
    <view class="hero"><text class="hero-title">现场模式</text><text class="hero-copy">{{statsText}}</text><view class="feature-row"><text wx:if="{{activity.groupingEnabled}}">智能组队</text><text wx:if="{{activity.scoringEnabled}}">参与者计分</text></view></view>
    <view class="section-head"><text class="section-title">到场球友</text><text class="secondary">{{participants.length}} 人</text></view>
    <view class="people surface"><view wx:for="{{participants}}" wx:key="userId" class="person"><view class="person-avatar">{{item.nickname}}</view><text>{{item.nickname}}</text><text class="attendance {{item.attendanceStatus === 'CHECKED_IN' ? 'checked' : ''}}">{{item.attendanceStatus === 'CHECKED_IN' ? '已到场' : '未到场'}}</text></view></view>
    <view wx:if="{{activity.groupingEnabled && activity.canManage}}" class="tool surface"><view><text class="section-title">生成下一轮</text><text class="secondary">优先安排上场较少的已到场球友</text></view><picker range="{{courtOptions}}" value="{{courtIndex}}" bindchange="onCourtChange"><view class="picker">{{courtOptions[courtIndex]}} ›</view></picker><button class="primary-button tool-button" loading="{{submitting}}" bindtap="generateRound">生成分组建议</button></view>
    <view wx:if="{{rounds.length > 0}}" class="section-head"><text class="section-title">轮次</text></view>
    <view wx:for="{{rounds}}" wx:key="id" class="round surface"><view><text class="round-title">第 {{item.roundNo}} 轮</text><text class="secondary">{{item.status === 'DRAFT' ? '待组织者发布' : '已发布'}}</text></view><button wx:if="{{activity.canManage && item.status === 'DRAFT'}}" class="publish" data-id="{{item.id}}" bindtap="publishRound">发布安排</button></view>
    <view wx:if="{{activity.scoringEnabled}}" class="manual surface"><text class="section-title">手动创建对局</text><picker range="{{matchTypes}}" range-key="label" value="{{matchTypeIndex}}" bindchange="onMatchTypeChange"><view class="match-type-picker"><text>对局类型</text><text>{{matchTypes[matchTypeIndex].label}} ›</text></view></picker><text class="secondary">{{matchTypeIndex === 0 ? '依次选择2人，第一位为A方，第二位为B方' : '依次选择4人，前两人为A队，后两人为B队'}}</text><checkbox-group class="select-players" bindchange="onPlayerChange"><label wx:for="{{participants}}" wx:key="userId" class="check-person"><checkbox value="{{item.userId}}" color="#007aff" />{{item.nickname}}</label></checkbox-group><text class="selection-count">已选择 {{selectedPlayers.length}} / {{matchTypes[matchTypeIndex].playerCount}} 人</text><button class="outline-button" loading="{{submitting}}" bindtap="createMatch">创建{{matchTypes[matchTypeIndex].label}}对局</button></view>
    <view class="section-head"><text class="section-title">对局与比分</text><text class="secondary">{{matches.length}} 场</text></view>
    <view wx:if="{{matches.length === 0}}" class="empty surface">还没有对局安排</view>
    <view wx:for="{{matches}}" wx:key="id" wx:for-index="matchIndex" class="match surface"><view class="match-head"><view><text class="court">{{item.courtLabel}}</text><text class="match-type-label">{{item.matchType === 'SINGLES' ? '单打' : '双打'}}</text></view><text class="status">{{item.statusText}}</text></view><view class="team-row"><text class="team">{{item.teamAText}}</text><input wx:if="{{activity.scoringEnabled}}" type="number" data-index="{{matchIndex}}" data-side="A" value="{{item.inputScoreA}}" bindinput="onScoreInput" /><text wx:else class="versus">VS</text></view><view class="team-row"><text class="team">{{item.teamBText}}</text><input wx:if="{{activity.scoringEnabled}}" type="number" data-index="{{matchIndex}}" data-side="B" value="{{item.inputScoreB}}" bindinput="onScoreInput" /></view><button wx:if="{{activity.canManage && item.status === 'DRAFT'}}" class="adjust-button" data-index="{{matchIndex}}" bindtap="updateDraftMatch">用已选4人调整此场</button><view wx:if="{{activity.scoringEnabled}}" class="match-actions"><button wx:if="{{item.status !== 'LOCKED' && item.status !== 'DRAFT'}}" class="small primary" data-index="{{matchIndex}}" bindtap="submitScore">提交比分</button><button wx:if="{{item.status === 'PENDING_CONFIRMATION' && item.isPlayer}}" class="small" data-index="{{matchIndex}}" bindtap="confirmScore">确认</button><button wx:if="{{activity.canManage && item.status === 'PENDING_CONFIRMATION'}}" class="small" data-index="{{matchIndex}}" bindtap="lockScore">组织者锁定</button><button wx:if="{{activity.canManage && item.status === 'LOCKED'}}" class="small danger" data-index="{{matchIndex}}" bindtap="unlockScore">解锁更正</button></view><text wx:if="{{item.confirmationText && item.status !== 'LOCKED'}}" class="secondary confirm-text">已确认队伍：{{item.confirmationText}}</text></view>
  </block>
</view>

