.form-page { box-sizing:border-box; min-height:100vh; padding:24rpx 32rpx 220rpx; background:linear-gradient(180deg,var(--primary-soft) 0,var(--page-bg) 530rpx); color:var(--text); }
.form-hero { position:relative; overflow:hidden; min-height:340rpx; border-radius:var(--surface-radius); background:linear-gradient(135deg,var(--primary),var(--hero-end)); color:#fff; box-shadow:0 18rpx 46rpx rgba(25,55,90,.2); }.form-hero-image,.form-hero-shade,.court-decoration { position:absolute; inset:0; width:100%; height:100%; }.form-hero-image { opacity:.78; }.form-hero-shade { background:linear-gradient(112deg,rgba(5,25,42,.28),rgba(5,25,42,.86)); }.court-decoration { opacity:.16; }.court-line { position:absolute; background:var(--surface); }.court-line.vertical { top:0; bottom:0; left:72%; width:2rpx; }.court-line.horizontal { top:60%; right:0; left:0; height:2rpx; }.court-circle { position:absolute; top:36%; right:-36rpx; width:180rpx; height:180rpx; border:2rpx solid #fff; border-radius:50%; }.form-hero-content { position:relative; z-index:1; padding:38rpx 40rpx; }.hero-kicker,.hero-title,.hero-copy { display:block; }.hero-kicker { font-size:18rpx; font-weight:750; letter-spacing:3rpx; opacity:.8; }.hero-title { margin-top:13rpx; font-size:43rpx; font-weight:780; line-height:1.2; }.hero-copy { max-width:560rpx; margin-top:14rpx; font-size:24rpx; line-height:1.52; opacity:.92; }.hero-tags { display:flex; flex-wrap:wrap; gap:12rpx; margin-top:24rpx; }.hero-tags text { padding:8rpx 16rpx; border:1rpx solid rgba(255,255,255,.38); border-radius:999rpx; background:rgba(255,255,255,.13); font-size:19rpx; font-weight:650; }
.group-heading { display:flex; align-items:center; margin:38rpx 5rpx 16rpx; }.group-icon { flex:none; display:flex; align-items:center; justify-content:center; width:58rpx; height:58rpx; margin-right:16rpx; border-radius:18rpx; background:var(--primary-soft); color:var(--primary); font-size:22rpx; font-weight:750; }.group-icon.warm { background:#fff0df; color:#dc721a; }.group-icon.green { background:#e2f7ed; color:#14855e; }.group-icon.purple { background:#f0eaff; color:#7357c7; }.group-icon.cyan { background:#e0f6fa; color:#168098; }.group-title,.group-copy { display:block; }.group-title { font-size:29rpx; font-weight:750; }.group-copy { margin-top:4rpx; color:var(--muted); font-size:19rpx; }.step { margin-left:auto; color:var(--primary); font-size:22rpx; font-weight:750; letter-spacing:2rpx; }.step.optional { padding:6rpx 13rpx; border-radius:999rpx; background:var(--primary-soft); font-size:18rpx; letter-spacing:0; }
.form-card { position:relative; overflow:hidden; padding:0 26rpx; }.form-card::before { content:""; position:absolute; top:0; right:0; left:0; height:5rpx; background:var(--primary); opacity:.9; }.accent-orange::before { background:#f08b35; }.accent-green::before { background:#28a978; }.accent-purple::before { background:#8066d4; }.loading { display:flex; align-items:center; justify-content:center; gap:14rpx; margin-top:28rpx; padding:50rpx; color:var(--muted); text-align:center; }.loading-dot { width:18rpx; height:18rpx; border-radius:50%; background:var(--primary); box-shadow:0 0 0 9rpx var(--primary-soft); }
.field,.toggle-row { display:flex; align-items:center; justify-content:space-between; min-height:102rpx; border-bottom:1rpx solid var(--border); }.field:last-child,.toggle-row:last-child { border-bottom:0; }.label { flex:none; margin-right:22rpx; color:var(--text); font-size:27rpx; font-weight:650; }.control { flex:1; min-width:0; color:var(--text); font-size:25rpx; text-align:right; }.control input { text-align:right; }.placeholder { color:var(--muted); opacity:.7; }.picker-value { overflow:hidden; color:var(--text); text-overflow:ellipsis; white-space:nowrap; }.picker-value text { margin-left:5rpx; color:var(--primary); font-size:32rpx; }.date-control { display:flex; gap:12rpx; color:var(--primary); font-size:23rpx; font-weight:650; }.date-control picker { padding:13rpx 15rpx; border-radius:13rpx; background:var(--primary-soft); }.number-control { display:flex; align-items:center; gap:8rpx; color:var(--muted); font-size:25rpx; }.number-control input { box-sizing:border-box; width:100rpx; height:52rpx; padding:0; border-radius:13rpx; background:var(--primary-soft); color:var(--primary); font-size:26rpx; font-weight:700; line-height:52rpx; text-align:center; }
.textarea-field { display:flex; flex-direction:column; padding:27rpx 0 30rpx; }.textarea-field .label { margin-bottom:16rpx; }.textarea-field textarea { box-sizing:border-box; width:100%; height:170rpx; padding:22rpx; border:2rpx solid transparent; border-radius:var(--control-radius); background:var(--page-bg); color:var(--text); font-size:25rpx; line-height:1.5; }.textarea-field textarea:focus { border-color:var(--primary); }
.toggle-row { min-height:118rpx; padding:11rpx 0; }.tool-copy { display:flex; align-items:center; min-width:0; }.mini-icon { flex:none; display:flex; align-items:center; justify-content:center; width:54rpx; height:54rpx; margin-right:15rpx; border-radius:17rpx; background:var(--primary-soft); color:var(--primary); font-size:21rpx; font-weight:750; }.mini-icon.score { background:#e2f7ed; color:#14855e; }.toggle-title,.toggle-copy { display:block; }.toggle-title { font-size:27rpx; font-weight:650; }.toggle-copy { max-width:390rpx; margin-top:5rpx; color:var(--muted); font-size:20rpx; line-height:1.35; }.message,.draft-message { display:block; margin-top:28rpx; padding:18rpx 22rpx; border-radius:var(--control-radius); background:var(--primary-soft); color:var(--primary); font-size:22rpx; text-align:center; }.draft-message { padding:0; background:transparent; color:var(--muted); }.field-error,.venue-warning { display:block; margin:10rpx 0 14rpx; color:#d65f27; font-size:21rpx; line-height:1.5; }.field-count { display:block; margin-top:8rpx; color:var(--muted); font-size:19rpx; text-align:right; }.clear-draft { width:240rpx; margin:18rpx auto 0; border:0; background:transparent; color:var(--muted); font-size:21rpx; }.clear-draft::after { border:0; }
.profile-alert { display:flex; align-items:center; gap:16rpx; margin:26rpx 0 8rpx; padding:24rpx; border:2rpx solid #ffbf69; border-radius:var(--control-radius); background:#fff4e5; box-shadow:0 10rpx 28rpx rgba(189,99,0,.12); }.alert-icon { flex:none; display:flex; align-items:center; justify-content:center; width:52rpx; height:52rpx; border-radius:50%; background:#ff9500; color:#fff; font-size:28rpx; font-weight:800; }.alert-copy { flex:1; min-width:0; }.profile-alert-title,.profile-alert-copy { display:block; }.profile-alert-title { color:#9a4d00; font-size:26rpx; font-weight:750; }.profile-alert-copy { margin-top:6rpx; color:#815522; font-size:20rpx; line-height:1.45; }.profile-alert button { flex:none; box-sizing:border-box; min-width:106rpx; height:62rpx; margin:0; padding:0 18rpx; border:0; border-radius:999rpx; background:#ff9500; color:#fff; font-size:22rpx; }.profile-alert button::after { border:0; }
.save-bar { position:fixed; right:0; bottom:0; left:0; z-index:10; display:flex; align-items:center; gap:22rpx; box-sizing:border-box; padding:18rpx 32rpx calc(22rpx + env(safe-area-inset-bottom)); border-top:1rpx solid var(--border); background:rgba(255,255,255,.95); box-shadow:0 -12rpx 34rpx rgba(20,45,70,.11); backdrop-filter:blur(18px); }.save-copy { flex:1; min-width:0; }.save-copy text { display:block; }.save-copy text:first-child { color:var(--text); font-size:23rpx; font-weight:700; }.save-copy text:last-child { margin-top:4rpx; color:var(--muted); font-size:18rpx; }.save { flex:none; width:300rpx; height:92rpx; margin:0; padding:0 25rpx; border-radius:var(--control-radius); box-shadow:0 10rpx 24rpx rgba(0,122,255,.2); }
.mode-dark.form-page { background:linear-gradient(180deg,#17212b 0,var(--page-bg) 560rpx); }.mode-dark .form-hero { box-shadow:none; }.mode-dark .save-bar { background:rgba(27,30,34,.96); }.mode-dark .profile-alert { border-color:#8a5a20; background:#3a2b19; }.mode-dark .profile-alert-title { color:#ffc170; }.mode-dark .profile-alert-copy { color:#e4bd89; }
@media (max-width:360px) { .save-copy { display:none; }.save { width:100%; }.date-control { gap:7rpx; }.date-control picker { padding:12rpx 10rpx; }.toggle-copy { max-width:300rpx; } }
.load-failed { margin-top:28rpx; padding:48rpx 30rpx; text-align:center; }.retry-initialize { width:280rpx; margin:26rpx auto 0; }.save-bar { background:var(--surface); }
@media (max-width:430px) { .field { align-items:stretch; flex-direction:column; justify-content:center; gap:14rpx; padding:22rpx 0; }.label { margin-right:0; }.control,.control input { width:100%; text-align:left; }.picker-value { white-space:normal; }.date-control { width:100%; flex-wrap:wrap; }.date-control picker { flex:1; min-width:210rpx; text-align:center; }.number-control { align-self:flex-start; } }
@media (max-width:360px) { .form-page { padding-right:24rpx; padding-left:24rpx; }.profile-alert { align-items:flex-start; flex-wrap:wrap; }.profile-alert button { width:100%; }.date-control picker { min-width:0; }.retry-initialize { width:100%; }.clear-draft { width:100%; } }

.form-page { padding-bottom:calc(230rpx + env(safe-area-inset-bottom)); }
.form-page .save-bar { right:20rpx; bottom:calc(12rpx + env(safe-area-inset-bottom)); left:20rpx; min-height:112rpx; padding:14rpx 20rpx; border:1rpx solid rgba(255,255,255,.86); border-radius:30rpx; background:rgba(245,249,253,.94); box-shadow:0 14rpx 38rpx rgba(20,43,69,.16); backdrop-filter:blur(18px) saturate(130%); -webkit-backdrop-filter:blur(18px) saturate(130%); }
.form-page.mode-dark .save-bar { border-color:rgba(255,255,255,.18); background:rgba(27,35,46,.94); box-shadow:0 14rpx 38rpx rgba(0,0,0,.28); }
.form-page .save { display:flex; align-items:center; justify-content:center; box-sizing:border-box; min-width:0; }
.form-hero { min-height:220rpx; box-shadow:none; }
.form-hero-content { padding:30rpx 34rpx; }
.form-hero .hero-title { font-size:38rpx; }
.form-hero .hero-copy { margin-top:8rpx; font-size:21rpx; }
.form-hero .hero-tags { display:none; }
.group-heading { margin-top:28rpx; }
.form-card::before { height:0; }
.copy-latest,.more-toggle { display:flex; align-items:center; justify-content:center; box-sizing:border-box; width:100%; min-height:80rpx; margin:20rpx 0 0; border:1rpx solid var(--border); border-radius:var(--control-radius); background:var(--surface); color:var(--primary); font-size:24rpx; font-weight:650; }
.copy-latest::after,.more-toggle::after { border:0; }
.more-toggle { justify-content:space-between; padding:0 26rpx; color:var(--text); }
.more-toggle text:first-child { flex:none; white-space:nowrap; }
.more-toggle text:last-child { flex:1; min-width:0; margin-left:16rpx; overflow:hidden; color:var(--muted); font-size:21rpx; text-align:right; text-overflow:ellipsis; white-space:nowrap; }
.more-card { margin-top:14rpx; }
