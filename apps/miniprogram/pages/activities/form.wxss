.form-page { box-sizing:border-box; min-height:100vh; padding:16rpx 32rpx 190rpx; background:#f2f2f7; }
.group-title { display:block; margin:30rpx 16rpx 14rpx; color:#6e6e73; font-size:23rpx; font-weight:600; }.form-card { overflow:hidden; padding:0 30rpx; }.loading { padding:50rpx; color:#6e6e73; text-align:center; }
.field,.toggle-row { display:flex; align-items:center; justify-content:space-between; min-height:98rpx; border-bottom:1rpx solid #e5e5ea; }.field:last-child,.toggle-row:last-child { border-bottom:0; }.label { flex:none; margin-right:24rpx; font-size:28rpx; font-weight:550; }.control { flex:1; min-width:0; color:#3c3c43; font-size:27rpx; text-align:right; }.control input { text-align:right; }.date-control { display:flex; gap:22rpx; color:#007aff; font-size:25rpx; }.number-control { display:flex; align-items:center; gap:8rpx; color:#6e6e73; font-size:26rpx; }.number-control input { width:90rpx; color:#1d1d1f; text-align:right; }
.textarea-field { display:flex; flex-direction:column; padding:27rpx 0; }.textarea-field .label { margin-bottom:18rpx; }.textarea-field textarea { box-sizing:border-box; width:100%; height:150rpx; padding:22rpx; border-radius:24rpx; background:#f7f7fa; font-size:26rpx; line-height:1.5; }
.toggle-row { padding:17rpx 0; }.toggle-title,.toggle-copy { display:block; }.toggle-title { font-size:28rpx; font-weight:550; }.toggle-copy { margin-top:5rpx; color:#8e8e93; font-size:22rpx; }.message { display:block; margin-top:24rpx; color:#6e6e73; font-size:23rpx; text-align:center; }
.save-bar { position:fixed; z-index:10; right:0; bottom:0; left:0; box-sizing:border-box; padding:20rpx 40rpx calc(24rpx + env(safe-area-inset-bottom)); border-top:1rpx solid #e5e5ea; background:rgba(255,255,255,.96); }.save { height:100rpx; line-height:100rpx; }
