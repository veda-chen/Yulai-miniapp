:host { display:block; width:100%; }.hero { position:relative; overflow:hidden; box-sizing:border-box; width:100%; min-height:350rpx; border-radius:var(--surface-radius,36rpx); background:#244756; color:#fff; box-shadow:0 14rpx 40rpx rgba(0,0,0,.15); }.image,.shade,.court-lines { position:absolute; inset:0; width:100%; height:100%; }.shade { background:linear-gradient(118deg,rgba(8,28,43,.28),rgba(8,28,43,.8)); }.gradient { background:linear-gradient(135deg,var(--primary,#007aff),var(--hero-end,#1d3f66)); }.gradient .shade { background:linear-gradient(135deg,rgba(255,255,255,.08),rgba(4,20,40,.24)); }.court-lines { opacity:.2; }.court-line { position:absolute; background:#fff; }.court-line.vertical { top:0; bottom:0; left:70%; width:2rpx; }.court-line.horizontal { top:58%; right:0; left:0; height:2rpx; }.court-circle { position:absolute; top:32%; left:58%; width:180rpx; height:180rpx; border:2rpx solid #fff; border-radius:50%; }.content { position:relative; z-index:1; box-sizing:border-box; min-height:350rpx; padding:40rpx 44rpx; }.kicker,.title,.description { display:block; }.kicker { font-size:18rpx; font-weight:750; letter-spacing:3rpx; opacity:.76; }.title { max-width:520rpx; margin-top:14rpx; font-size:44rpx; font-weight:780; line-height:1.22; }.description { max-width:520rpx; margin-top:15rpx; font-size:26rpx; line-height:1.5; opacity:.92; }.action { display:inline-flex; align-items:center; justify-content:center; height:76rpx; margin-top:28rpx; padding:0 30rpx; border-radius:var(--control-radius,20rpx); background:#fff; color:var(--primary,#007aff); font-size:26rpx; font-weight:700; box-shadow:0 8rpx 24rpx rgba(0,0,0,.18); }.plus { margin-right:7rpx; font-size:32rpx; }.readonly { min-height:270rpx; box-shadow:none; }.readonly .content { min-height:270rpx; padding:30rpx; }.readonly .title { font-size:34rpx; }.readonly .description { font-size:22rpx; }.readonly .action { height:64rpx; margin-top:20rpx; font-size:22rpx; }
.hero:not(.readonly),.hero:not(.readonly) .content { min-height:278rpx; }
.hero:not(.readonly) { box-shadow:0 16rpx 36rpx rgba(12,41,68,.13); }
.hero:not(.readonly).photo .shade { background:linear-gradient(90deg,rgba(7,27,42,.9) 0%,rgba(7,27,42,.7) 48%,rgba(7,27,42,.08) 100%); }
.hero:not(.readonly) .content { padding:31rpx 36rpx 29rpx; }
.hero:not(.readonly) .kicker { font-size:18rpx; letter-spacing:2rpx; opacity:.86; }
.hero:not(.readonly) .title { margin-top:13rpx; font-size:42rpx; line-height:1.17; }
.hero:not(.readonly) .description { max-width:480rpx; margin-top:12rpx; font-size:21rpx; line-height:1.42; }
.hero:not(.readonly) .action { height:66rpx; margin-top:20rpx; padding:0 25rpx; border-radius:16rpx; box-shadow:0 6rpx 18rpx rgba(0,0,0,.12); font-size:23rpx; }
