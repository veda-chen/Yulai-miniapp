:host { display:block; min-width:0; max-width:100%; }.board { display:flex; align-items:stretch; box-sizing:border-box; width:100%; max-width:100%; padding:30rpx 24rpx; overflow:hidden; border:var(--surface-border-width,1rpx) solid var(--border,#e5e5ea); border-radius:36rpx; background:var(--surface,#fff); color:var(--text,#1d1d1f); box-shadow:var(--surface-shadow,0 4rpx 12rpx rgba(0,0,0,.04)); }.board.court { background:linear-gradient(155deg,#173c32,#0d6653); color:#fff; }.player { flex:1; min-width:0; display:flex; flex-direction:column; align-items:center; }.player input,.name { box-sizing:border-box; width:100%; height:64rpx; border-bottom:1rpx solid var(--border,#e0e5e3); color:inherit; font-size:25rpx; font-weight:650; line-height:64rpx; text-align:center; }.score { margin:28rpx 0; font-size:94rpx; font-weight:780; line-height:1; }.side-a { color:var(--primary,#147af3); }.side-b { color:#11866f; }.court .side-a,.court .side-b { color:#fff; }.divider { display:flex; flex:none; align-items:center; padding:0 20rpx; color:var(--muted,#a1aaa6); font-size:20rpx; }.actions { display:grid; grid-template-columns:72rpx minmax(0,100rpx); gap:12rpx; max-width:100%; }.actions button { box-sizing:border-box; width:72rpx; min-width:0; max-width:100%; height:64rpx; margin:0; padding:0; border:0; border-radius:20rpx; background:#eef1f3; color:#53616a; font-size:27rpx; font-weight:700; }.actions .plus { width:100%; color:#fff; }.side-a-bg { background:var(--primary,#147af3) !important; }.side-b-bg { background:#11866f !important; }.court .actions button { background:rgba(255,255,255,.16); color:#fff; }.court .actions .plus { background:#fff !important; color:#164b3e; }.actions button::after { border:0; }
@media (max-width:360px) { .board { padding-right:16rpx; padding-left:16rpx; }.divider { padding-right:10rpx; padding-left:10rpx; }.actions { grid-template-columns:62rpx minmax(0,86rpx); gap:8rpx; }.actions button { width:62rpx; }.score { font-size:82rpx; } }
.board { border-radius:var(--surface-radius,36rpx); }
