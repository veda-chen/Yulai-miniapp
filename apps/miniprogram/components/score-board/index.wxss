.board { display:flex; align-items:stretch; box-sizing:border-box; padding:30rpx 24rpx; border:1rpx solid var(--border,#e5e5ea); border-radius:36rpx; background:var(--surface,#fff); color:var(--text,#1d1d1f); box-shadow:0 4rpx 12rpx rgba(0,0,0,.04); }.board.court { background:linear-gradient(155deg,#173c32,#0d6653); color:#fff; }.player { flex:1; min-width:0; display:flex; flex-direction:column; align-items:center; }.player input,.name { box-sizing:border-box; width:100%; height:64rpx; border-bottom:1rpx solid var(--border,#e0e5e3); color:inherit; font-size:25rpx; font-weight:650; line-height:64rpx; text-align:center; }.score { margin:28rpx 0; font-size:94rpx; font-weight:780; line-height:1; }.side-a { color:var(--primary,#147af3); }.side-b { color:#11866f; }.court .side-a,.court .side-b { color:#fff; }.divider { display:flex; align-items:center; padding:0 20rpx; color:var(--muted,#a1aaa6); font-size:20rpx; }.actions { display:flex; gap:12rpx; }.actions button { box-sizing:border-box; width:72rpx; height:64rpx; margin:0; padding:0; border:0; border-radius:20rpx; background:#eef1f3; color:#53616a; font-size:27rpx; font-weight:700; }.actions .plus { width:100rpx; color:#fff; }.side-a-bg { background:var(--primary,#147af3) !important; }.side-b-bg { background:#11866f !important; }.court .actions button { background:rgba(255,255,255,.16); color:#fff; }.court .actions .plus { background:#fff !important; color:#164b3e; }.actions button::after { border:0; }
.board { border-radius:var(--surface-radius,36rpx); }
