:host { display:block; flex:none; width:100%; }.activity-card { display:block; box-sizing:border-box; width:100%; min-height:250rpx; padding:30rpx; border:var(--surface-border-width,1rpx) solid var(--border,#e5e5ea); border-radius:var(--surface-radius,36rpx); background:var(--surface,#fff); color:var(--text,#1d1d1f); box-shadow:var(--surface-shadow,0 10rpx 28rpx rgba(30,55,84,.07)); transition:transform var(--motion-duration,160ms) ease; }.activity-card:active { transform:scale(var(--press-scale,.99)); }
.activity-card.compact { min-height:210rpx; padding:24rpx 26rpx; }
.top,.meta,.time-group,.venue-row { display:flex; align-items:flex-start; }.top,.meta { justify-content:space-between; gap:14rpx; flex-wrap:wrap; }.time-group { min-width:0; }.time-icon { flex:none; display:flex; align-items:center; justify-content:center; width:48rpx; height:48rpx; margin-right:15rpx; border-radius:15rpx; background:var(--primary-soft,#e8f2ff); color:var(--primary,#007aff); }.clock-icon { position:relative; box-sizing:border-box; width:25rpx; height:25rpx; border:3rpx solid currentColor; border-radius:50%; }.clock-icon::before,.clock-icon::after { content:""; position:absolute; top:5rpx; left:10rpx; width:3rpx; border-radius:3rpx; background:currentColor; transform-origin:bottom center; }.clock-icon::before { height:7rpx; }.clock-icon::after { height:6rpx; transform:rotate(125deg); }.time,.date,.title,.venue { display:block; }.time { font-size:var(--font-title,29rpx); font-weight:750; }.date { margin-top:4rpx; color:var(--muted,#6e6e73); font-size:22rpx; }.status { flex:none; padding:8rpx 18rpx; border-radius:999rpx; background:#34c759; color:#fff; font-size:21rpx; font-weight:650; }.status.waiting { background:#fff3d1; color:#815a00; }.title { display:-webkit-box; margin-top:24rpx; overflow:hidden; font-size:var(--font-title,28rpx); font-weight:700; line-height:1.35; -webkit-box-orient:vertical; -webkit-line-clamp:2; }.compact .title { margin-top:17rpx; }.venue-row { margin-top:14rpx; }.venue-icon { position:relative; flex:none; box-sizing:border-box; width:21rpx; height:21rpx; margin:4rpx 11rpx 0 3rpx; border:3rpx solid var(--primary,#007aff); border-radius:50% 50% 50% 0; transform:rotate(-45deg); }.pin-dot { position:absolute; top:5rpx; left:5rpx; width:5rpx; height:5rpx; border-radius:50%; background:var(--primary,#007aff); }.venue { display:-webkit-box; overflow:hidden; color:var(--muted,#6e6e73); font-size:var(--font-body,25rpx); line-height:1.4; -webkit-box-orient:vertical; -webkit-line-clamp:2; }.compact .venue-row { margin-top:9rpx; }.compact .venue { font-size:var(--font-small,23rpx); -webkit-line-clamp:2; }.meta { margin-top:24rpx; color:var(--muted,#6e6e73); font-size:var(--font-small,23rpx); }.compact .meta { margin-top:15rpx; font-size:21rpx; }
