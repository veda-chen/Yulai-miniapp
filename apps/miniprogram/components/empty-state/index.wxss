:host { display:block; flex:none; width:100%; min-width:0; max-width:100%; }.empty { box-sizing:border-box; min-height:210rpx; padding:34rpx; border:var(--surface-border-width,1rpx) solid var(--border,#e5e5ea); border-radius:var(--surface-radius,36rpx); background:var(--surface,#fff); color:var(--text,#1d1d1f); box-shadow:var(--surface-shadow,none); }.title,.description { display:block; }.title { font-size:var(--font-title,28rpx); font-weight:650; }.description { margin-top:10rpx; color:var(--muted,#6e6e73); font-size:var(--font-small,23rpx); }.action,.action-button { max-width:100%; margin-top:20rpx; color:var(--primary,#007aff); font-size:var(--font-body,24rpx); font-weight:650; }.action-button { width:auto; min-width:0; height:auto; margin-right:0; margin-left:0; padding:0; border:0; background:transparent; line-height:1.4; }.action-button::after { border:0; }
