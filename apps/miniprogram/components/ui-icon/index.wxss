:host { display:inline-flex; flex:none; }.icon { --tone-background:var(--primary-soft,#e8f2ff); display:flex; align-items:center; justify-content:center; box-sizing:border-box; border-radius:var(--icon-radius,18rpx); background:var(--icon-background,var(--tone-background)); color:var(--primary,#007aff); font-size:21rpx; font-weight:750; transition:transform var(--motion-duration,160ms) ease; }.icon image { width:55%; height:55%; }.icon.green { --tone-background:#e2f7ed; color:#14855e; }.icon.orange { --tone-background:#fff0df; color:#c96716; }.icon.purple { --tone-background:#f0eaff; color:#7357c7; }.icon.neutral { --tone-background:var(--page-bg,#f2f2f7); color:var(--muted,#6e6e73); }
