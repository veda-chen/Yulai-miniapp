:host { display:block; min-width:0; max-width:100%; }.section-header { display:flex; align-items:center; min-width:0; min-height:62rpx; }.marker { display:var(--section-marker-display,block); flex:none; width:9rpx; height:34rpx; margin-right:14rpx; border-radius:999rpx; background:var(--primary,#007aff); box-shadow:0 0 0 7rpx var(--primary-soft,#e8f2ff); }.number { display:var(--section-number-display,none); flex:none; align-items:center; justify-content:center; box-sizing:border-box; min-width:54rpx; height:54rpx; margin-right:14rpx; padding:0 10rpx; border-radius:var(--icon-radius,18rpx); background:var(--primary-soft,#e8f2ff); color:var(--primary,#007aff); font-size:19rpx; font-weight:750; }.copy { flex:1; min-width:0; }.title,.description { display:block; }.title { color:var(--text,#1d1d1f); font-size:31rpx; font-weight:750; }.description { margin-top:5rpx; color:var(--muted,#6e6e73); font-size:20rpx; line-height:1.4; }.action { flex:none; max-width:38%; margin-left:18rpx; overflow:hidden; color:var(--primary,#007aff); font-size:22rpx; font-weight:650; text-overflow:ellipsis; white-space:nowrap; }.button-reset { width:auto; min-width:0; max-width:38%; height:auto; padding:0; border:0; background:transparent; }.button-reset::after { border:0; }
