:host { display:block; }
.tool-card { display:flex; align-items:center; box-sizing:border-box; min-height:154rpx; padding:26rpx 28rpx; border:1rpx solid rgba(28,75,112,.08); border-radius:30rpx; background:#fff; box-shadow:0 10rpx 28rpx rgba(30,67,95,.06); }.tool-icon { flex:none; display:flex; align-items:center; justify-content:center; width:82rpx; height:82rpx; margin-right:23rpx; border-radius:25rpx; font-size:30rpx; font-weight:750; }.tool-icon.blue { background:#e5f1ff; color:#147af3; }.tool-icon.green { background:#dff7ef; color:#11866f; }.tool-icon.orange { background:#fff1d9; color:#b66b00; }.tool-main { flex:1; min-width:0; }.tool-title-row { display:flex; align-items:center; gap:12rpx; }.tool-title,.tool-description { display:block; }.tool-title { font-size:29rpx; font-weight:700; }.tool-badge { padding:5rpx 11rpx; border-radius:999rpx; background:#eef6ff; color:#147af3; font-size:18rpx; font-weight:650; }.tool-description { margin-top:9rpx; color:#6e7a83; font-size:22rpx; line-height:1.45; }.tool-arrow { margin-left:16rpx; color:#9aa4ab; font-size:42rpx; }
