:host { display:inline-flex; }.chip { display:inline-flex; align-items:center; justify-content:center; box-sizing:border-box; min-height:42rpx; padding:6rpx 14rpx; border:1rpx solid transparent; border-radius:999rpx; font-size:20rpx; font-weight:650; line-height:1.2; }.primary { background:var(--primary-soft,#e8f2ff); color:var(--primary,#007aff); }.success { background:#e2f7ea; color:#147a43; }.warning { background:#fff3d1; color:#815a00; }.danger { background:#ffe8e6; color:#b42318; }.muted { border-color:var(--border,#e5e5ea); background:var(--page-bg,#f2f2f7); color:var(--muted,#6e6e73); }
