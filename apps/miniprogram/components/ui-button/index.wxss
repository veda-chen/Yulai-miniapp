:host { display:block; flex:1; }.ui-button { display:flex; align-items:center; justify-content:center; box-sizing:border-box; width:100%; height:82rpx; margin:0; padding:0 20rpx; border:1rpx solid transparent; border-radius:999rpx; font-size:25rpx; font-weight:650; line-height:1.2; text-align:center; }.ui-button::after { border:0; }.primary { background:var(--primary,#007aff); color:#fff; }.secondary { border-color:var(--border,#e5e5ea); background:var(--surface,#fff); color:var(--muted,#6e6e73); }.danger { border-color:#ff3b30; background:var(--surface,#fff); color:#ff3b30; }
