:host { display:block; flex:1; min-width:0; max-width:100%; }.ui-button { display:flex; align-items:center; justify-content:center; box-sizing:border-box; width:100%; min-width:0; height:82rpx; margin:0; padding:0 20rpx; border:2rpx solid transparent; border-radius:var(--control-radius,999rpx); font-size:25rpx; font-weight:650; line-height:1.2; text-align:center; box-shadow:var(--button-shadow,none); transition:transform var(--motion-duration,160ms) ease,opacity var(--motion-duration,160ms) ease; }.ui-button:active { transform:scale(.98); }.ui-button::after { border:0; }.primary { border-color:var(--button-primary-border,transparent); background:var(--button-primary-bg,var(--primary,#007aff)); color:var(--button-primary-color,#fff); }.secondary { border-color:var(--border,#e5e5ea); background:var(--surface,#fff); color:var(--muted,#6e6e73); box-shadow:none; }.danger { border-color:#ff3b30; background:var(--surface,#fff); color:#ff3b30; box-shadow:none; }
