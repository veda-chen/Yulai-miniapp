{
  "$schema": "https://static.cloudbase.net/cli/cloudbaserc.schema.json",
  "version": "2.0",
  "envId": "{{env.CLOUDBASE_ENV_ID}}",
  "region": "ap-shanghai",
  "functionRoot": "cloudfunctions",
  "functions": [
    {
      "name": "api",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 10,
      "memorySize": 256,
      "installDependency": true,
      "envVariables": {
        "OPENID_HASH_SECRET": "{{env.OPENID_HASH_SECRET}}",
        "SUBSCRIPTION_OPENID_KEY": "{{env.SUBSCRIPTION_OPENID_KEY}}",
        "WECHAT_MINIPROGRAM_STATE": "{{env.WECHAT_MINIPROGRAM_STATE}}"
      },
      "triggers": [
        {
          "name": "purge-deleted-users-daily",
          "type": "timer",
          "config": "0 30 3 * * * *"
        },
        {
          "name": "deliver-subscription-notifications-every-minute",
          "type": "timer",
          "config": "0 */1 * * * * *"
        }
      ]
    }
  ]
}
